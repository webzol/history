page {
  background: #F6F1EA;
  color: #1F1D19;
  font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, image {
  box-sizing: border-box;
}

.serif {
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.topbar.nav-with-back {
  height: 44px;
  margin-top: 46px;
  margin-top: max(46px, calc(env(safe-area-inset-top, 0px) + 6px));
}

.back-hit {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  min-width: 44px;
  min-height: 44px;
}

.back {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 156rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFDF9, #F9F4EB);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06), inset 0 1rpx 0 #FFF;
  transition: transform 0.12s ease, background 0.12s ease;
}

.back-hit-pressed .back {
  transform: scale(0.97);
  background: #F1E8DD;
}

.back-icon {
  position: relative;
  flex: 0 0 32rpx;
  height: 20rpx;
}

.back-chevron {
  position: absolute;
  top: 3rpx;
  left: 1rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  transform: rotate(45deg);
}

.back-shaft {
  position: absolute;
  top: 9rpx;
  left: 7rpx;
  width: 22rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #8A6A3E;
}

.back-divider {
  flex: 0 0 1rpx;
  height: 18rpx;
  margin: 0 10rpx 0 5rpx;
  background: rgba(138, 106, 62, 0.20);
}

.back-label {
  color: #6B5A33;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.3;
  letter-spacing: 0.06em;
  white-space: nowrap;
}

.section-action {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 44px;
  min-height: 44px;
  padding-left: 12rpx;
}

.search-clear {
  flex: 0 0 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  color: #6D645A;
  font-size: 34rpx;
}

/* 底部 tab（真实渲染：custom-tab-bar/index.wxss；此处同份样式供 web 预览外壳使用） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  min-height: 128rpx;
  padding: 16rpx 20rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(250, 248, 243, 0.96);
  border-top: 1rpx solid rgba(70, 58, 45, 0.10);
}

.tab {
  flex: 1;
  min-height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: #6D645A;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  opacity: 0.52;
}

.tab.active {
  color: #211E1A;
}

.tab.active .tab-icon {
  opacity: 1;
}

/* 阅读字号：s 小 / m 标准 / l 大 / xl 特大；页面根节点挂 fs-*，子元素字号用 calc(... * var(--fs)) */
.fs-s { --fs: 0.9; }
.fs-m { --fs: 1; }
.fs-l { --fs: 1.14; }
.fs-xl { --fs: 1.28; }

/* 小屏隐藏顶栏小印，并让短标题略微右移，避开较宽的返回胶囊 */
@media (max-width: 360px) {
  .page .top-seal { display: none; }
  .page .top-title { left: 56%; }
}

/* 分享面板（详情页通用，utils/qrshare.js；视觉对齐 profile 的 info sheet） */
.ss-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
}

.ss-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 29, 25, 0.3);
  animation: ssFade 0.18s ease both;
}

.ss-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 86vh;
  overflow-y: auto;
  padding: 16rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #FCFBF8;
  border-radius: 42rpx 42rpx 0 0;
  box-shadow: 0 -24rpx 52rpx rgba(90, 70, 50, 0.16);
  animation: ssUp 0.24s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.ss-grip {
  width: 66rpx;
  height: 6rpx;
  margin: 4rpx auto 14rpx;
  border-radius: 3rpx;
  background: #E6E0D4;
}

.ss-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 8rpx 16rpx;
  border-bottom: 1rpx solid rgba(31, 29, 25, 0.06);
}

.ss-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(33rpx * var(--fs, 1));
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.ss-close {
  font-size: 40rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  color: #6D645A;
}

.ss-close-touch {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
}

.ss-qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 34rpx;
}

.ss-canvas {
  width: 260px;
  height: 424px;
  border-radius: 20rpx;
  background: #F4EEE4;
  box-shadow: 0 0 0 1px rgba(70, 58, 45, 0.12);
}


.ss-actions { display: flex; gap: 16rpx; max-width: 306px; margin: 0 auto; }
.share-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  gap: 12rpx;
  min-width: 0;
  min-height: 46px;
  margin: 0;
  padding: 10rpx 12rpx;
  border: 0;
  border-radius: 26rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.4;
}
.share-action::after { border: 0; }
.send-action { background: #F1E8DD; color: #63472F; }
.save-action { background: #EEF0F0; color: #454C4A; }
.send-action.share-action-pressed { background: #EBDFD1; }
.save-action.share-action-pressed { background: #E3E8E7; }
.save-action.share-pending { color: #706C63; }

.share-action-icon { position: relative; flex: 0 0 32rpx; width: 32rpx; height: 32rpx; }
.send-icon::before, .save-icon::before, .save-icon::after { position: absolute; content: ''; }
.send-icon::before {
  left: 4rpx;
  bottom: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border: 1px solid currentColor;
  border-radius: 4rpx;
}
.send-icon::after {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;
  background: linear-gradient(135deg, transparent 45%, currentColor 46%, currentColor 54%, transparent 55%), #F1E8DD;
  content: '';
}
.share-action-pressed .send-icon::after { background-color: #EBDFD1; }
.save-icon::before {
  left: 5rpx;
  bottom: 4rpx;
  right: 5rpx;
  height: 7rpx;
  border: 1px solid currentColor;
  border-top: 0;
  border-radius: 0 0 3rpx 3rpx;
}
.save-icon::after {
  top: 11rpx;
  left: 11rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: rotate(45deg);
}
.save-icon { background: linear-gradient(currentColor, currentColor) center 4rpx / 1px 14rpx no-repeat; }

@keyframes ssFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes ssUp {
  from { transform: translateY(42%); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}
