page {
  background: #F6F1EA;
  color: #1F1D19;
  font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, image {
  box-sizing: border-box;
}

.serif {
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

/* 底部 tab（真实渲染：custom-tab-bar/index.wxss；此处同份样式供 web 预览外壳使用） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  min-height: 128rpx;
  padding: 16rpx 20rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(250, 248, 243, 0.96);
  border-top: 1rpx solid rgba(70, 58, 45, 0.10);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: #7B746A;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  opacity: 0.52;
}

.tab.active {
  color: #211E1A;
}

.tab.active .tab-icon {
  opacity: 1;
}

/* 阅读字号：s 小 / m 标准 / l 大 / xl 特大；页面根节点挂 fs-*，子元素字号用 calc(... * var(--fs)) */
.fs-s { --fs: 0.9; }
.fs-m { --fs: 1; }
.fs-l { --fs: 1.14; }
.fs-xl { --fs: 1.28; }

/* 小屏隐藏顶栏小印，并让短标题略微右移，避开较宽的返回胶囊 */
@media (max-width: 360px) {
  .page .top-seal { display: none; }
  .page .top-title { left: 56%; }
}

/* 分享面板（详情页通用，utils/qrshare.js；视觉对齐 profile 的 info sheet） */
.ss-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
}

.ss-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 29, 25, 0.3);
  animation: ssFade 0.18s ease both;
}

.ss-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 86vh;
  overflow-y: auto;
  padding: 16rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #FCFBF8;
  border-radius: 42rpx 42rpx 0 0;
  box-shadow: 0 -24rpx 52rpx rgba(90, 70, 50, 0.16);
  animation: ssUp 0.24s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.ss-grip {
  width: 66rpx;
  height: 6rpx;
  margin: 4rpx auto 14rpx;
  border-radius: 3rpx;
  background: #E6E0D4;
}

.ss-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 8rpx 16rpx;
  border-bottom: 1rpx solid rgba(31, 29, 25, 0.06);
}

.ss-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(33rpx * var(--fs, 1));
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.ss-close {
  font-size: 40rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  color: #8C857A;
}

.ss-qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 34rpx;
}

.ss-canvas {
  width: 260px;
  height: 424px;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1px solid rgba(70, 58, 45, 0.12);
}

.ss-qr-tip {
  margin-top: 16rpx;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.1em;
  color: #8C857A;
}

/* open-type="share" 的原生 button 与普通 view 按钮同款 reset */
.ss-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84rpx;
  margin: 0 0 14rpx;
  padding: 0;
  border-radius: 42rpx;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  line-height: 1;
  box-sizing: border-box;
}

.ss-btn::after {
  border: none;
}

.ss-btn-primary {
  background: #1F1D19;
  color: #F6F1EA;
}

.ss-btn-ghost {
  background: #EEF0F0;
  color: #5F5A52;
}

@keyframes ssFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes ssUp {
  from { transform: translateY(42%); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}
