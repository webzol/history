.feedback-layer, .feedback-toast {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 46rpx;
  box-sizing: border-box;
}

.feedback-layer {
  z-index: 900;
  background: rgba(31, 29, 25, 0.36);
}

.feedback-card, .feedback-pill {
  box-sizing: border-box;
  background: #FCFBF8;
  border: 1rpx solid #E8E1D7;
  box-shadow: 0 14rpx 38rpx rgba(31, 29, 25, 0.12);
}

.feedback-card {
  width: 100%;
  max-width: 620rpx;
  max-height: 80vh;
  overflow-y: auto;
  padding: 34rpx;
  border-radius: 40rpx;
}

.feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #E8E1D7;
}

.feedback-title {
  font-family: "Songti SC", STSong, SimSun, serif;
  font-size: calc(36rpx * var(--fs, 1));
  line-height: 1.35;
  color: #1F1D19;
}

.feedback-seal {
  width: 39rpx;
  height: 49rpx;
  flex: none;
}

.feedback-content {
  display: block;
  margin: 24rpx 0 0;
  font-size: calc(27rpx * var(--fs, 1));
  line-height: 1.65;
  white-space: pre-wrap;
  color: #5F5A52;
}

.feedback-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 16rpx;
}

.feedback-button {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 12rpx;
  margin: 0;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
  font-family: inherit;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.45;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-button::after { border: 0; }
.feedback-cancel { color: #5F5A52; background: #F1EBE2; border-color: #E8E1D7; }
.feedback-confirm { color: #FCFBF8; background: #A34A3E; }
.feedback-pressed { opacity: 0.78; }

.feedback-toast {
  z-index: 1050;
  align-items: flex-end;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.feedback-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 22rpx 32rpx;
  border-radius: 32rpx;
  color: #5F5A52;
  font-size: calc(25rpx * var(--fs, 1));
  line-height: 1.5;
  text-align: center;
}

.feedback-tick { color: #53674A; font-weight: bold; }
.feedback-spinner {
  flex: none;
  width: 27rpx;
  height: 27rpx;
  border-radius: 50%;
  border: 3rpx solid #E8E1D7;
  border-top-color: #A34A3E;
  animation: feedback-spin 0.85s linear infinite;
}

@keyframes feedback-spin { to { transform: rotate(360deg); } }
