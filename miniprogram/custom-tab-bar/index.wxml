<view class="tabbar">
  <view
    class="tab {{active === item.key ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="key"
    data-key="{{item.key}}"
    bindtap="onTabTap"
    aria-role="button"
    aria-label="{{item.label + (active === item.key ? '，当前页面' : '')}}"
  >
    <image aria-hidden="true" class="tab-icon" src="{{active === item.key && item.activeIcon ? item.activeIcon : item.icon}}" mode="aspectFit"></image>
    <text>{{item.label}}</text>
  </view>
</view>
