<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen">
    <view class="topbar">
      <view class="back" bindtap="goBack" hover-class="back-pressed" hover-stay-time="80">
        <view class="back-icon">
          <view class="back-chevron"></view>
          <view class="back-shaft"></view>
        </view>
        <view class="back-divider"></view>
        <text class="back-label">返回</text>
      </view>
      <text class="top-title">资料库</text>
      <image class="top-seal" src="/assets/seal.png" mode="aspectFit"></image>
    </view>

    <view wx:if="{{loading}}" class="state-card">
      <text class="state-title">正在打开资料</text>
      <text class="state-desc">首次加载需要片刻。</text>
    </view>

    <view wx:elif="{{error}}" class="state-card error" bindtap="retry">
      <text class="state-title">{{error}}</text>
      <text class="state-action">点此重试</text>
    </view>

    <block wx:else>
      <view class="head-card">
        <view class="head-cover-wrap">
          <image class="head-cover" src="{{cover}}" mode="aspectFill"></image>
          <view class="head-cover-fade"></view>
        </view>
        <view class="head-body">
          <view class="head-row">
            <view class="head-copy">
              <text class="head-kicker">{{kicker}}</text>
              <text class="head-title">{{item.title}}</text>
            </view>
            <view wx:if="{{art}}" class="head-fig">
              <image class="head-fig-img" src="{{art}}" mode="aspectFit" binderror="onArtErr"></image>
            </view>
          </view>
          <text wx:if="{{showMeta}}" class="head-meta">{{item.meta}}</text>
        </view>
      </view>

      <view wx:if="{{showLead || showSections || showBody || showTranslation}}" class="body-card">
        <view wx:if="{{showLead}}" class="lead">
          <text>{{item.summary}}</text>
        </view>

        <view wx:if="{{showSections}}" class="sections">
          <view wx:for="{{sections}}" wx:key="id" class="section {{item.tone}}">
            <view wx:if="{{item.label}}" class="section-head">
              <text class="section-label">{{item.label}}</text>
              <text class="section-rule"></text>
            </view>
            <text
              wx:for="{{item.paras}}"
              wx:key="id"
              class="section-para"
            >{{item.text}}</text>
          </view>
        </view>

        <block wx:elif="{{showBody}}">
          <block wx:for="{{blocks}}" wx:key="id">
            <text wx:if="{{item.kind === 'heading'}}" class="para-head">{{item.text}}</text>
            <view wx:else class="para">
              <text>{{item.text}}</text>
            </view>
          </block>
        </block>

        <view wx:if="{{showTranslation}}" class="translation">
          <text class="trans-title">译文</text>
          <text class="trans-text">{{item.translation}}</text>
        </view>
      </view>

      <view wx:if="{{factRows.length}}" class="facts">
        <view class="facts-head">
          <text class="facts-title">资料卡</text>
          <text class="facts-count">{{factRows.length}} 项</text>
        </view>
        <view class="fact-grid">
          <view wx:for="{{factRows}}" wx:key="id" class="fact-item {{item.wide ? 'wide' : ''}}">
            <text wx:if="{{item.key}}" class="fact-key">{{item.key}}</text>
            <text class="fact-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{item.source}}" class="source-line">来源：{{item.source}} · 史页资料库</view>
    </block>
  </view>
</view>
