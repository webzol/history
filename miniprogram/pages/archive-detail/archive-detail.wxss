.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  width: 240rpx;
  height: 56rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(176, 142, 96, 0.42);
  background: rgba(252, 251, 248, 0.86);
  box-shadow: 0 4rpx 12rpx rgba(90, 70, 50, 0.05);
  overflow: hidden;
}

.back-arrow {
  position: absolute;
  left: 20rpx;
  top: 50%;
  width: 56rpx;
  height: auto;
  display: block;
  transform: translateY(-50%);
}

.back-label {
  position: absolute;
  left: 76rpx;
  right: 18rpx;
  top: 0;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 26rpx;
  letter-spacing: 0.1em;
  text-indent: 0.1em;
  color: #6B5A33;
}

.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #8C857A;
}

.top-seal {
  position: absolute;
  right: 200rpx;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 44rpx;
  height: 50rpx;
  display: block;
}

.head-card {
  margin-top: 28rpx;
  padding: 38rpx 34rpx 34rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  border-top: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.head-kicker {
  display: block;
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.12em;
  color: #A9825E;
}

.head-title {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(40rpx * var(--fs, 1));
  line-height: 1.45;
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.head-meta {
  display: block;
  margin-top: 14rpx;
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.5;
  color: #8C857A;
}

.body-card {
  margin-top: 20rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.lead {
  margin-bottom: 26rpx;
  padding: 20rpx 22rpx;
  border-left: 5rpx solid rgba(169, 130, 94, 0.55);
  border-radius: 0 18rpx 18rpx 0;
  background: #F7F2E9;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.75;
  color: #5F5A52;
}

.para {
  margin-bottom: 22rpx;
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.9;
  letter-spacing: 0.015em;
  color: #2C2924;
  text-align: justify;
}

.para:last-child {
  margin-bottom: 0;
}

.para-head {
  display: block;
  margin: 30rpx 0 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #A34A3E;
}

.para-head:first-child {
  margin-top: 0;
}

.translation {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(169, 130, 94, 0.35);
}

.trans-title {
  display: block;
  margin-bottom: 10rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.1em;
  color: #A9825E;
}

.trans-text {
  display: block;
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.85;
  color: #5F5A52;
}

.facts {
  margin-top: 20rpx;
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  background: #F3EFE6;
}

.facts-title {
  display: block;
  margin-bottom: 12rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.1em;
  color: #6B5A33;
}

.fact {
  display: block;
  margin-top: 7rpx;
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.65;
  color: #5F5A52;
}

.source-line {
  margin-top: 30rpx;
  font-size: calc(18rpx * var(--fs, 1));
  line-height: 1.6;
  letter-spacing: 0.03em;
  color: #A39A8E;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 70rpx 30rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  text-align: center;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.state-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  color: #5F5A52;
}

.state-desc {
  font-size: calc(18rpx * var(--fs, 1));
  line-height: 1.6;
  color: #A39A8E;
}

.state-action {
  margin-top: 4rpx;
  font-size: calc(20rpx * var(--fs, 1));
  color: #A34A3E;
}
