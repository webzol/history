.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 56rpx;
  padding: 0 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.95) 0%, rgba(249, 244, 235, 0.88) 100%);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  overflow: hidden;
  transition: transform 0.12s ease, background 0.12s ease;
}

.back-pressed {
  transform: scale(0.97);
  background: rgba(244, 236, 224, 0.96);
}

.back-icon {
  position: relative;
  width: 32rpx;
  height: 20rpx;
  flex: 0 0 32rpx;
}

.back-chevron {
  position: absolute;
  left: 1rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.back-shaft {
  position: absolute;
  left: 7rpx;
  top: 9rpx;
  width: 22rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(138, 106, 62, 0.92), rgba(138, 106, 62, 0.62));
}

.back-divider {
  width: 1rpx;
  height: 18rpx;
  margin: 0 10rpx 0 5rpx;
  background: rgba(138, 106, 62, 0.20);
  flex: 0 0 1rpx;
}

.back-label {
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  text-indent: 0.08em;
  color: #6B5A33;
  white-space: nowrap;
}

.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #8C857A;
}

.top-seal {
  position: absolute;
  right: 200rpx;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 44rpx;
  height: 50rpx;
  display: block;
}

.head-card {
  margin-top: 28rpx;
  padding: 0;
  border-radius: 38rpx;
  background: #FCFBF8;
  border-top: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
  overflow: hidden;
}

.head-cover-wrap {
  position: relative;
  height: 160rpx;
  background: #E8E2D6;
  overflow: hidden;
}

.head-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.head-cover-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 54rpx;
  background: linear-gradient(180deg, rgba(252, 251, 248, 0), #FCFBF8);
}

.head-body {
  padding: 28rpx 34rpx 32rpx;
}

.head-kicker {
  display: inline-block;
  padding: 5rpx 13rpx;
  border: 1rpx solid rgba(169, 130, 94, 0.2);
  border-radius: 999rpx;
  background: #F7F2E9;
  font-size: calc(16rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8C6A45;
}

.head-title {
  display: block;
  margin-top: 16rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(40rpx * var(--fs, 1));
  line-height: 1.42;
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.head-meta {
  display: block;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(169, 130, 94, 0.24);
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.5;
  color: #8C857A;
}

.body-card {
  margin-top: 20rpx;
  padding: 32rpx 32rpx 34rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.sections {
  display: block;
}

.section {
  margin-bottom: 30rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.section-label {
  flex: none;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.12em;
  color: #A34A3E;
}

.section-rule {
  display: block;
  flex: 1;
  height: 1rpx;
  margin-left: 14rpx;
  background: linear-gradient(90deg, rgba(169, 130, 94, 0.28), rgba(169, 130, 94, 0));
}

.section-para {
  display: block;
  margin-bottom: 16rpx;
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.9;
  letter-spacing: 0.015em;
  color: #2C2924;
  text-align: justify;
}

.section-para:last-child {
  margin-bottom: 0;
}

.section.verse .section-para {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 2;
  color: #1F1D19;
}

.section.note .section-para {
  font-size: calc(21rpx * var(--fs, 1));
  line-height: 1.82;
  color: #5F5A52;
}

.lead {
  margin-bottom: 26rpx;
  padding: 20rpx 22rpx;
  border-left: 5rpx solid rgba(169, 130, 94, 0.55);
  border-radius: 0 18rpx 18rpx 0;
  background: #F7F2E9;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.75;
  color: #5F5A52;
}

.para {
  margin-bottom: 22rpx;
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.9;
  letter-spacing: 0.015em;
  color: #2C2924;
  text-align: justify;
}

.para:last-child {
  margin-bottom: 0;
}

.para-head {
  display: block;
  margin: 30rpx 0 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #A34A3E;
}

.para-head:first-child {
  margin-top: 0;
}

.translation {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(169, 130, 94, 0.35);
}

.trans-title {
  display: block;
  margin-bottom: 10rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.1em;
  color: #A9825E;
}

.trans-text {
  display: block;
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.85;
  color: #5F5A52;
}

.facts {
  margin-top: 22rpx;
  padding: 26rpx 30rpx 20rpx;
  border: 1rpx solid rgba(169, 130, 94, 0.1);
  border-radius: 28rpx;
  background: #F3EFE6;
}

.facts-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.facts-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.1em;
  color: #6B5A33;
}

.facts-count {
  font-size: calc(16rpx * var(--fs, 1));
  color: #A39A8E;
}

.fact-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.fact-item {
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  padding: 10rpx 8rpx;
}

.fact-item.wide {
  width: 100%;
}

.fact-key {
  display: block;
  font-size: calc(16rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #A39A8E;
}

.fact-value {
  display: block;
  margin-top: 3rpx;
  font-size: calc(21rpx * var(--fs, 1));
  line-height: 1.55;
  color: #3A342C;
}

.source-line {
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(243, 239, 230, 0.58);
  font-size: calc(17rpx * var(--fs, 1));
  line-height: 1.6;
  letter-spacing: 0.03em;
  color: #8C857A;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 70rpx 30rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  text-align: center;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.state-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  color: #5F5A52;
}

.state-desc {
  font-size: calc(18rpx * var(--fs, 1));
  line-height: 1.6;
  color: #A39A8E;
}

.state-action {
  margin-top: 4rpx;
  font-size: calc(20rpx * var(--fs, 1));
  color: #A34A3E;
}
