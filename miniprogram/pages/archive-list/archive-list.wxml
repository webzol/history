<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen">
    <view class="topbar">
      <view class="back" bindtap="goBack" hover-class="back-pressed" hover-stay-time="80">
        <view class="back-icon">
          <view class="back-chevron"></view>
          <view class="back-shaft"></view>
        </view>
        <view class="back-divider"></view>
        <text class="back-label">返回</text>
      </view>
      <text class="top-title">资料库</text>
      <image class="top-seal" src="/assets/seal.png" mode="aspectFit"></image>
    </view>

    <view class="search-card">
      <text class="search-icon">⌕</text>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="{{searchPlaceholder}}"
        placeholder-class="ph"
        confirm-type="search"
        bindinput="onInput"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">×</text>
    </view>

    <view class="cover-card">
      <image class="cover-img" src="{{cover}}" mode="aspectFill"></image>
      <view class="cover-mask"></view>
      <view class="cover-copy">
        <text class="cover-kicker">史页资料库 · 分类</text>
        <text class="cover-title">{{pageTitle}}</text>
        <text class="cover-meta">{{coverMeta}}</text>
      </view>
    </view>

    <view wx:if="{{keyword}}" class="list-head">
      <text class="list-hint">匹配“{{keyword}}”</text>
    </view>

    <view wx:if="{{loading}}" class="state-card">
      <text class="state-title">正在打开资料库</text>
      <text class="state-desc">首次加载需要片刻，之后会缓存在本机。</text>
    </view>

    <view wx:elif="{{error}}" class="state-card error" bindtap="retry">
      <text class="state-title">{{error}}</text>
      <text class="state-action">点此重试</text>
    </view>

    <view wx:elif="{{empty}}" class="state-card">
      <text class="state-title">没有找到相关资料</text>
      <text class="state-desc">换一个关键词试试。</text>
    </view>

    <block wx:else>
      <view class="item-list">
        <view
          wx:for="{{shown}}"
          wx:key="id"
          class="item"
          data-id="{{item.id}}"
          data-shard="{{item.shard}}"
          bindtap="onItem"
        >
          <view class="item-main">
            <text class="item-title">{{item.title}}</text>
            <text wx:if="{{item.meta}}" class="item-meta">{{item.meta}}</text>
            <text wx:if="{{item.summary}}" class="item-summary">{{item.summary}}</text>
          </view>
          <text class="item-arrow">›</text>
        </view>
      </view>

      <view wx:if="{{shown.length < total}}" class="more" bindtap="onMore">
        加载更多（{{shown.length}} / {{total}}）
      </view>
      <view wx:else class="end">已到末尾</view>
    </block>
  </view>
</view>
