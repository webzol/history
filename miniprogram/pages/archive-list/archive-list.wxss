.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  width: 240rpx;
  height: 56rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(176, 142, 96, 0.42);
  background: rgba(252, 251, 248, 0.86);
  box-shadow: 0 4rpx 12rpx rgba(90, 70, 50, 0.05);
  overflow: hidden;
}

.back-arrow {
  position: absolute;
  left: 20rpx;
  top: 50%;
  width: 56rpx;
  height: auto;
  display: block;
  transform: translateY(-50%);
}

.back-label {
  position: absolute;
  left: 76rpx;
  right: 18rpx;
  top: 0;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 26rpx;
  letter-spacing: 0.1em;
  text-indent: 0.1em;
  color: #6B5A33;
}

.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #8C857A;
}

.top-seal {
  position: absolute;
  right: 200rpx;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 44rpx;
  height: 50rpx;
  display: block;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: #FCFBF8;
  border: 1rpx solid rgba(176, 142, 96, 0.22);
  box-shadow: 0 10rpx 24rpx rgba(90, 70, 50, 0.04);
}

.search-icon {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #A9825E;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  font-size: calc(22rpx * var(--fs, 1));
  color: #1F1D19;
}

.ph {
  color: #B4AA9C;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1ECE2;
  font-size: 26rpx;
  color: #8C857A;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 4rpx 14rpx;
}

.list-count {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  color: #A9825E;
}

.list-hint {
  max-width: 420rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: calc(17rpx * var(--fs, 1));
  color: #A39A8E;
}

.item-list {
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
  overflow: hidden;
}

.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 26rpx;
  border-bottom: 1rpx solid rgba(70, 58, 45, 0.07);
}

.item:last-child {
  border-bottom: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.45;
  letter-spacing: 0.03em;
  color: #1F1D19;
}

.item-meta {
  display: block;
  margin-top: 6rpx;
  font-size: calc(17rpx * var(--fs, 1));
  line-height: 1.45;
  color: #A9825E;
}

.item-summary {
  display: -webkit-box;
  margin-top: 7rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.55;
  color: #5F5A52;
}

.item-arrow {
  flex: 0 0 auto;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #C0B6A8;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 70rpx 30rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  text-align: center;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.state-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  color: #5F5A52;
}

.state-desc {
  font-size: calc(18rpx * var(--fs, 1));
  line-height: 1.6;
  color: #A39A8E;
}

.state-action {
  margin-top: 4rpx;
  font-size: calc(20rpx * var(--fs, 1));
  color: #A34A3E;
}

.more {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #F3EFE6;
  text-align: center;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #6B5A33;
}

.end {
  margin-top: 24rpx;
  text-align: center;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #B4AA9C;
}
