<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen">
    <view class="topbar">
      <view class="back" bindtap="goBack">
        <image class="back-arrow" src="/assets/back-arrow.png" mode="widthFix"></image>
        <text class="back-label">返回</text>
      </view>
      <text class="top-title">资料库</text>
    </view>

    <view class="hero">
      <text class="hero-kicker">从辞条到人物 · 按类翻阅</text>
      <text class="hero-title">史页资料库</text>
      <text class="hero-desc">从历史资料中整理，共 {{stats.totalText}} 条。首次打开某类时按需加载，常读内容会缓存在本机。</text>
      <view class="hero-stats">
        <view class="hstat">
          <text class="hnum">{{stats.cardsText}}</text>
          <text class="hlab">典籍辞条</text>
        </view>
        <view class="hstat">
          <text class="hnum">{{stats.figuresText}}</text>
          <text class="hlab">历代人物</text>
        </view>
        <view class="hstat">
          <text class="hnum">{{stats.eventsText}}</text>
          <text class="hlab">历史事件</text>
        </view>
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">按类翻阅</text>
      <text class="section-link">{{openKey ? '再点收起' : '点击展开'}}</text>
    </view>
    <view class="group-list">
      <block wx:for="{{rows}}" wx:key="key">
        <view
          wx:if="{{item.rowType === 'group'}}"
          class="group-card {{item.open ? 'open' : ''}}"
          data-key="{{item.groupKey}}"
          bindtap="onToggle"
        >
          <text class="group-index">{{item.index}}</text>
          <view class="group-main">
            <view class="group-title-row">
              <text class="group-name">{{item.name}}</text>
              <text class="group-meta">{{item.meta}}</text>
            </view>
            <text class="group-desc">{{item.desc}}</text>
          </view>
          <text class="group-count">{{item.countText}}</text>
          <text class="group-chevron {{item.open ? 'open' : ''}}">›</text>
        </view>
        <view
          wx:elif="{{item.rowType === 'item'}}"
          class="entry-row"
          data-kind="{{item.kind}}"
          data-type="{{item.type}}"
          data-name="{{item.name}}"
          bindtap="onEntry"
        >
          <view class="entry-main">
            <text class="entry-name">{{item.name}}</text>
            <text class="entry-desc">{{item.desc}}</text>
          </view>
          <text class="entry-count">{{item.countText}}</text>
          <text class="entry-arrow">›</text>
        </view>
      </block>
    </view>

    <view class="note">资料为原型整理内容，仅作阅读与内容迁移；正式发布前请逐条核对史实与授权。</view>
  </view>
</view>
