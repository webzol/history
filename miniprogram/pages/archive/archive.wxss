.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 56rpx;
  padding: 0 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.95) 0%, rgba(249, 244, 235, 0.88) 100%);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  overflow: hidden;
  transition: transform 0.12s ease, background 0.12s ease;
}

.back-pressed {
  transform: scale(0.97);
  background: rgba(244, 236, 224, 0.96);
}

.back-icon {
  position: relative;
  width: 32rpx;
  height: 20rpx;
  flex: 0 0 32rpx;
}

.back-chevron {
  position: absolute;
  left: 1rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.back-shaft {
  position: absolute;
  left: 7rpx;
  top: 9rpx;
  width: 22rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(138, 106, 62, 0.92), rgba(138, 106, 62, 0.62));
}

.back-divider {
  width: 1rpx;
  height: 18rpx;
  margin: 0 10rpx 0 5rpx;
  background: rgba(138, 106, 62, 0.20);
  flex: 0 0 1rpx;
}

.back-label {
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  text-indent: 0.08em;
  color: #6B5A33;
  white-space: nowrap;
}

.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8C857A;
}

.hero {
  position: relative;
  margin-top: 26rpx;
  padding: 38rpx 34rpx 32rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  border-top: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.hero-kicker {
  display: block;
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.14em;
  color: #A9825E;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(46rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: calc(21rpx * var(--fs, 1));
  line-height: 1.75;
  color: #5F5A52;
}

.hero-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.hstat {
  flex: 1;
  min-width: 0;
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #F3EFE6;
  text-align: center;
}

.hnum {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  color: #A34A3E;
}

.hlab {
  display: block;
  margin-top: 4rpx;
  font-size: calc(17rpx * var(--fs, 1));
  color: #8C857A;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 2rpx 16rpx;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.section-link {
  font-size: calc(18rpx * var(--fs, 1));
  color: #A39A8E;
}

.group-list {
  display: block;
}

.group-card {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #FCFBF8;
  box-shadow: 0 12rpx 26rpx rgba(90, 70, 50, 0.04);
}

.group-card:active {
  background: #F7F3EC;
}

.group-card.open {
  background: #FBF7EF;
  box-shadow: 0 14rpx 30rpx rgba(90, 70, 50, 0.06);
}

.group-index {
  flex: none;
  width: 38rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #B9A98F;
}

.group-cover {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  margin-left: 10rpx;
  border-radius: 18rpx;
  background: #F3EFE6;
  display: block;
}

.group-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx 0 18rpx;
}

.group-title-row {
  display: flex;
  align-items: baseline;
}

.group-name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(28rpx * var(--fs, 1));
  color: #1F1D19;
}

.group-meta {
  margin-left: 12rpx;
  font-size: calc(17rpx * var(--fs, 1));
  color: #A39A8E;
}

.group-desc {
  display: block;
  margin-top: 5rpx;
  font-size: calc(18rpx * var(--fs, 1));
  line-height: 1.45;
  color: #8C857A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-count {
  flex: none;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  color: #A9825E;
}

.group-chevron {
  flex: none;
  width: 28rpx;
  margin-left: 8rpx;
  text-align: center;
  font-size: 30rpx;
  color: #C0B6A8;
  transition: transform 0.2s ease;
}

.group-chevron.open {
  transform: rotate(90deg);
}

.entry-row {
  display: flex;
  align-items: center;
  margin: 0 8rpx 8rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  border-radius: 20rpx;
  border-left: 3rpx solid rgba(169, 130, 94, 0.18);
  background: #FCFBF8;
  box-shadow: 0 6rpx 14rpx rgba(90, 70, 50, 0.03);
}

.entry-row:active {
  background: #F7F3EC;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-name {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  color: #1F1D19;
}

.entry-desc {
  display: block;
  margin-top: 4rpx;
  font-size: calc(17rpx * var(--fs, 1));
  line-height: 1.45;
  color: #8C857A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.entry-count {
  flex: none;
  margin-left: 16rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(21rpx * var(--fs, 1));
  color: #A9825E;
}

.entry-arrow {
  flex: none;
  margin-left: 8rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  color: #C0B6A8;
}

.note {
  margin-top: 32rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(243, 239, 230, 0.7);
  font-size: calc(17rpx * var(--fs, 1));
  line-height: 1.7;
  color: #A39A8E;
}
