.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 160rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(54rpx * var(--fs, 1));
  font-weight: 400;
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.intro {
  margin-top: 26rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.6;
  letter-spacing: 0.02em;
  color: #5F5A52;
}

.archive-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  border-left: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.05);
}

.archive-entry-copy {
  flex: 1;
  min-width: 0;
}

.archive-entry-kicker {
  display: block;
  font-size: calc(16rpx * var(--fs, 1));
  letter-spacing: 0.12em;
  color: #A9825E;
}

.archive-entry-title {
  display: block;
  margin-top: 7rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #1F1D19;
}

.archive-entry-desc {
  display: block;
  margin-top: 7rpx;
  font-size: calc(17rpx * var(--fs, 1));
  line-height: 1.5;
  color: #8C857A;
}

.archive-entry-badge {
  flex: 0 0 auto;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: #F3EFE6;
  text-align: center;
}

.archive-entry-num {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  color: #A34A3E;
}

.archive-entry-unit {
  display: block;
  margin-top: 2rpx;
  font-size: calc(15rpx * var(--fs, 1));
  color: #A39A8E;
}

.archive-entry-arrow {
  flex: 0 0 auto;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #C0B6A8;
}

.section-head {
  margin-top: 38rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(34rpx * var(--fs, 1));
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.section-link {
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #8C857A;
}

/* 朝代卡（2 列，按数据条数自动换行） */
.dyn-grid {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.dyn-card {
  position: relative;
  width: 320rpx;
  height: 300rpx;
  border-radius: 34rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.07);
}

.dyn-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.dyn-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(180deg, rgba(246, 241, 234, 0.06) 40%, rgba(31, 27, 22, 0.55));
}

.dyn-copy {
  position: absolute;
  left: 24rpx;
  bottom: 20rpx;
  z-index: 2;
}

.dyn-name {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(40rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #FFF8EF;
}

.dyn-years {
  display: block;
  margin-top: 6rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: rgba(255, 248, 239, 0.78);
}

.dyn-title {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  z-index: 2;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: rgba(31, 27, 22, 0.72);
  background: rgba(252, 251, 248, 0.72);
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
}

.dyn-card.dyn-modern .dyn-title {
  color: rgba(126, 154, 154, 0.95);
}

/* 专题卡（盛唐气象复用首页视觉语言） */
.era-card {
  position: relative;
  height: 216rpx;
  margin-top: 20rpx;
  padding: 26rpx 30rpx;
  border-radius: 38rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.era-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.era-shade {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 52%;
  background: linear-gradient(90deg, rgba(250, 247, 241, 0.42), rgba(250, 247, 241, 0));
  pointer-events: none;
}

.era-copy {
  position: relative;
  z-index: 2;
  max-width: 480rpx;
}

.era-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(34rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.era-desc {
  display: block;
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.55;
  color: #5F5A52;
}

.era-go {
  position: absolute;
  right: 28rpx;
  bottom: 22rpx;
  z-index: 2;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(36rpx * var(--fs, 1));
  color: rgba(31, 27, 22, 0.45);
}

.modern-card {
  position: relative;
  height: 200rpx;
  margin-top: 16rpx;
  padding: 28rpx 30rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.05);
  display: flex;
  align-items: center;
  overflow: hidden;
}

.modern-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding-right: 150rpx;
}

.modern-kicker {
  display: block;
  font-size: calc(15rpx * var(--fs, 1));
  letter-spacing: 0.12em;
  color: #7E9A9A;
}

.modern-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(34rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #1F1D19;
}

.modern-desc {
  display: block;
  max-width: 420rpx;
  margin-top: 9rpx;
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.55;
  color: #5F5A52;
}

.modern-years {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.1;
  letter-spacing: 0.03em;
  color: #A9BCC4;
}

.modern-dash {
  width: 44rpx;
  height: 1rpx;
  margin: 8rpx 0;
  background: rgba(126, 154, 154, 0.55);
}

/* 精选史事 */
.pick-list {
  margin-top: 20rpx;
}

.pick-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.pick-year {
  width: 130rpx;
  flex: 0 0 130rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(22rpx * var(--fs, 1));
  color: #A9825E;
}

.pick-year-modern {
  color: #7E9A9A;
}

.pick-body {
  flex: 1;
  min-width: 0;
}

.pick-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.pick-desc {
  display: block;
  margin-top: 6rpx;
  font-size: calc(20rpx * var(--fs, 1));
  line-height: 1.55;
  color: #5F5A52;
}

.pick-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #A39A8E;
}

.tba-note {
  margin-top: 26rpx;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #A39A8E;
}

