<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen" wx:if="{{event}}">
    <view class="topbar">
      <view class="back" bindtap="goBack" hover-class="back-pressed" hover-stay-time="80">
        <view class="back-icon">
          <view class="back-chevron"></view>
          <view class="back-shaft"></view>
        </view>
        <view class="back-divider"></view>
        <text class="back-label">返回</text>
      </view>
      <view class="top-center">
        <text class="top-title">事件</text>
        <view class="top-seal">
          <text class="seal-char">{{seal}}</text>
        </view>
      </view>
    </view>

    <view class="head-card {{event.mode === 'modern' ? 'head-modern' : ''}}">
      <view class="e-copy">
        <text class="e-year">{{event.yearText}}</text>
        <text class="e-title">{{event.title}}</text>
        <view class="e-meta">
          <view class="era-chip {{event.mode === 'modern' ? 'chip-modern' : ''}}">
            <text>{{event.era}}</text>
          </view>
          <text class="e-tags">{{event.tags}}</text>
        </view>
      </view>
      <view class="e-fig" wx:if="{{headImg}}">
        <image class="e-fig-img" src="{{headImg}}" mode="aspectFit" binderror="onHeadImgErr"></image>
      </view>
    </view>

    <view class="body-card">
      <view class="para lead" wx:if="{{event.desc}}">
        <text>{{event.desc}}</text>
      </view>
      <view class="para" wx:for="{{event.details}}" wx:key="*this">
        <text>{{item}}</text>
      </view>
    </view>

    <view class="section-head" wx:if="{{relatedPersons.length}}">
      <text class="section-title">其时其人</text>
    </view>
    <view class="p-list" wx:if="{{relatedPersons.length}}">
      <view
        wx:for="{{relatedPersons}}"
        wx:key="id"
        class="p-card"
        data-id="{{item.id}}"
        bindtap="goPerson"
      >
        <view class="p-thumb-wrap">
          <image class="p-thumb-bg" src="{{item.fallback}}" mode="aspectFit"></image>
          <image
            wx:if="{{item.img !== item.fallback}}"
            class="p-thumb-img {{thumbLoaded[item.id] ? 'on' : ''}}" lazy-load
            src="{{item.img}}"
            mode="aspectFill"
            bindload="onThumbLoad"
            binderror="onThumbErr"
            data-id="{{item.id}}"
          ></image>
        </view>
        <view class="p-info">
          <text class="p-name">{{item.name}}</text>
          <text class="p-dates {{event.mode === 'modern' ? 'accent-modern' : ''}}">{{item.dates}}</text>
          <text class="p-roles">{{item.roles}}</text>
        </view>
        <text class="rel-arrow">›</text>
      </view>
    </view>

    <view class="foot-actions">
      <view class="ghost-btn {{collected ? (event.mode === 'modern' ? 'on on-modern' : 'on') : ''}}" bindtap="toggleCollect">
        <text>{{collected ? '✓ 已收藏' : '收藏此史事'}}</text>
      </view>
      <view class="ghost-btn" bindtap="goTimeline">
        <text>回时间轴再看一眼</text>
      </view>
    </view>

    <view class="source-line">史料 · {{event.source}}</view>
  </view>
</view>
