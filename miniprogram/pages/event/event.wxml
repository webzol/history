<view class="page fs-{{fontClass}}">
  <image aria-hidden="true" class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen" wx:if="{{event}}" aria-hidden="{{share.open}}">
    <view class="topbar nav-with-back">
      <view class="back-hit" bindtap="goBack" aria-role="button" aria-label="返回上一页"
        hover-class="back-hit-pressed" hover-stay-time="80">
        <view class="back" aria-hidden="true">
          <view class="back-icon">
            <view class="back-chevron"></view>
            <view class="back-shaft"></view>
          </view>
          <view class="back-divider"></view>
          <text class="back-label">返回</text>
        </view>
      </view>
      <view class="top-center">
        <text class="top-title">事件</text>
        <view class="top-seal" aria-hidden="true">
          <text class="seal-char">{{seal}}</text>
        </view>
      </view>
    </view>

    <view class="head-card {{event.mode === 'modern' ? 'head-modern' : ''}}">
      <view class="e-copy">
        <text class="e-title" aria-role="heading">{{event.title}}</text>
        <text class="e-year">{{event.yearText}}</text>
        <view class="e-meta">
          <view class="era-chip {{event.mode === 'modern' ? 'chip-modern' : ''}}">
            <text>{{event.era}}</text>
          </view>
          <text class="e-tags">{{event.tags}}</text>
        </view>
      </view>
      <view class="e-fig" wx:if="{{headImg}}">
        <image aria-hidden="true" class="e-fig-img" src="{{headImg}}" mode="aspectFit" binderror="onHeadImgErr"></image>
      </view>
    </view>

    <view class="body-card">
      <view class="para lead" wx:if="{{event.desc}}">
        <text>{{event.desc}}</text>
      </view>
      <view class="para" wx:for="{{event.details}}" wx:key="*this">
        <text>{{item}}</text>
      </view>
    </view>

    <view class="section-head" wx:if="{{relatedPersons.length}}">
      <text class="section-title" aria-role="heading">其时其人</text>
    </view>
    <view class="p-list" wx:if="{{relatedPersons.length}}">
      <view
        wx:for="{{relatedPersons}}"
        wx:key="id"
        class="p-card"
        data-id="{{item.id}}"
        bindtap="goPerson" aria-role="button" aria-label="{{item.name + '，' + item.dates + '，' + item.roles}}"
      >
        <view class="p-thumb-wrap">
          <image aria-hidden="true" class="p-thumb-bg" src="{{item.fallback}}" mode="aspectFit" lazy-load></image>
          <image aria-hidden="true"
            wx:if="{{item.img !== item.fallback}}"
            class="p-thumb-img {{thumbLoaded[item.id] ? 'on' : ''}}" lazy-load
            src="{{item.img}}"
            mode="aspectFill"
            bindload="onThumbLoad"
            binderror="onThumbErr"
            data-id="{{item.id}}"
          ></image>
        </view>
        <view class="p-info">
          <text class="p-name">{{item.name}}</text>
          <text class="p-dates {{event.mode === 'modern' ? 'accent-modern' : ''}}">{{item.dates}}</text>
          <text class="p-roles">{{item.roles}}</text>
        </view>
        <text class="rel-arrow" aria-hidden="true">›</text>
      </view>
    </view>

    <view class="foot-actions">
      <view class="ghost-btn {{collected ? (event.mode === 'modern' ? 'on on-modern' : 'on') : ''}}" bindtap="toggleCollect" aria-role="button" aria-label="{{collected ? '已收藏此史事，取消收藏' : '收藏此史事'}}">
        <text>{{collected ? '✓ 已收藏' : '收藏此史事'}}</text>
      </view>
      <view class="ghost-btn" bindtap="openShare" aria-role="button" aria-label="打开分享卡片">
        <text>共此卷</text>
      </view>
      <view class="ghost-btn" bindtap="goTimeline" aria-role="button">
        <text>回时间轴</text>
      </view>
    </view>

    <view class="source-line">史料 · {{event.source}}</view>

  </view>

    <view class="ss-layer" wx:if="{{share.open}}">
      <view class="ss-mask" aria-hidden="true" bindtap="closeShare"></view>
      <view class="ss-panel" aria-role="dialog" aria-modal="true" aria-label="分享卡片">
        <view class="ss-grip"></view>
        <view class="ss-head">
          <text class="ss-title">共此卷</text>
          <text class="ss-close ss-close-touch" bindtap="closeShare" aria-role="button" aria-label="关闭分享卡片">×</text>
        </view>
        <view class="ss-qr-wrap" aria-hidden="true">
          <image aria-hidden="true" wx:if="{{share.fallback}}" class="ss-canvas" src="/assets/share-fallback.jpg" mode="aspectFill"></image>
          <canvas wx:else type="2d" id="ssQrCanvas" class="ss-canvas" disable-scroll="true"></canvas>
        </view>
        <view class="ss-actions">
          <button class="share-action send-action" open-type="share" hover-class="share-action-pressed" hover-stay-time="80"
            aria-label="发送给好友">
            <view class="share-action-icon send-icon" aria-hidden="true"></view>
            <text>转寄好友</text>
          </button>
          <view class="share-action save-action" bindtap="saveQr" hover-class="share-action-pressed" hover-stay-time="80"
            aria-role="button" aria-label="保存分享卡片">
            <view class="share-action-icon save-icon" aria-hidden="true"></view>
            <text>保存卡片</text>
          </view>
        </view>
      </view>
    </view>
</view>

<feedback-popup></feedback-popup>
<privacy-popup></privacy-popup>
