.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  line-height: 1;
  color: #1F1D19;
}

.top-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: #8C857A;
}

.top-seal {
  width: 44rpx;
  height: 50rpx;
  background: #A34A3E;
  color: #FFF8EF;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(2deg);
}

.top-seal.seal-modern {
  background: #7E9A9A;
}

.head-card {
  margin-top: 26rpx;
  padding: 40rpx 34rpx 34rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  border-top: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.head-card.head-modern {
  border-top-color: rgba(126, 154, 154, 0.6);
}

.e-year {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.08em;
  color: #A9825E;
}

.head-modern .e-year {
  color: #7E9A9A;
}

.e-title {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  letter-spacing: 0.06em;
  line-height: 1.25;
  color: #1F1D19;
}

.e-meta {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.era-chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(169, 130, 94, 0.35);
  font-size: 19rpx;
  letter-spacing: 0.06em;
  color: #A9825E;
}

.era-chip.chip-modern {
  border-color: rgba(126, 154, 154, 0.45);
  color: #7E9A9A;
}

.e-tags {
  font-size: 19rpx;
  letter-spacing: 0.05em;
  color: #8C857A;
}

.body-card {
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.para {
  font-size: 23rpx;
  line-height: 1.85;
  letter-spacing: 0.02em;
  color: #2C2924;
}

.para + .para {
  margin-top: 22rpx;
}

.para.lead {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 25rpx;
  color: #1F1D19;
  margin-bottom: 22rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(70, 58, 45, 0.08);
}

.section-head {
  margin-top: 34rpx;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.p-list {
  margin-top: 18rpx;
}

.p-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.p-char {
  width: 96rpx;
  flex: 0 0 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(163, 74, 62, 0.08);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.05em;
  color: #A34A3E;
}

.p-info {
  flex: 1;
  min-width: 0;
}

.p-dates {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 20rpx;
  color: #A9825E;
}

.p-dates.accent-modern {
  color: #7E9A9A;
}

.p-roles {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 0.03em;
  color: #5F5A52;
}

.rel-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #A39A8E;
}

.foot-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.ghost-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(70, 58, 45, 0.14);
  border-radius: 38rpx;
  background: rgba(252, 251, 248, 0.6);
  font-size: 23rpx;
  letter-spacing: 0.05em;
  color: #5F5A52;
}

.ghost-btn.on {
  border-color: rgba(163, 74, 62, 0.45);
  background: rgba(163, 74, 62, 0.06);
  color: #A34A3E;
}

.ghost-btn.on.on-modern {
  border-color: rgba(126, 154, 154, 0.5);
  background: rgba(126, 154, 154, 0.08);
  color: #5F7E7E;
}

.source-line {
  margin-top: 30rpx;
  font-size: 19rpx;
  letter-spacing: 0.03em;
  color: #A39A8E;
}
