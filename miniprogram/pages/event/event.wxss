.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 56rpx;
  padding: 0 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.95) 0%, rgba(249, 244, 235, 0.88) 100%);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  overflow: hidden;
  transition: transform 0.12s ease, background 0.12s ease;
}

.back-pressed {
  transform: scale(0.97);
  background: rgba(244, 236, 224, 0.96);
}

.back-icon {
  position: relative;
  width: 32rpx;
  height: 20rpx;
  flex: 0 0 32rpx;
}

.back-chevron {
  position: absolute;
  left: 1rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.back-shaft {
  position: absolute;
  left: 7rpx;
  top: 9rpx;
  width: 22rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(138, 106, 62, 0.92), rgba(138, 106, 62, 0.62));
}

.back-divider {
  width: 1rpx;
  height: 18rpx;
  margin: 0 10rpx 0 5rpx;
  background: rgba(138, 106, 62, 0.20);
  flex: 0 0 1rpx;
}

.back-label {
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  text-indent: 0.08em;
  color: #6B5A33;
  white-space: nowrap;
}

.top-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.top-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8C857A;
}

.top-seal {
  width: 40rpx;
  height: 44rpx;
  opacity: 0.92;
  transform: rotate(3deg);
}

.head-card {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 26rpx;
  margin-top: 26rpx;
  padding: 30rpx;
  border-radius: 38rpx;
  overflow: hidden;
  background: #FCFBF8;
  border-top: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.e-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.e-fig {
  width: 200rpx;
  height: 200rpx;
  flex: 0 0 200rpx;
  align-self: center;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F3EFE6;
  border: 4rpx solid #FFFDF8;
  box-shadow: 0 10rpx 24rpx rgba(90, 70, 50, 0.10);
}

.e-fig-img {
  width: 100%;
  height: 100%;
  display: block;
  filter: saturate(0.82) brightness(1.02);
}

.head-card.head-modern {
  border-top-color: rgba(126, 154, 154, 0.6);
}

.e-year {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #A9825E;
}

.head-modern .e-year {
  color: #7E9A9A;
}

.e-title {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(50rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  line-height: 1.25;
  color: #1F1D19;
}

.e-meta {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.era-chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(169, 130, 94, 0.35);
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #A9825E;
}

.era-chip.chip-modern {
  border-color: rgba(126, 154, 154, 0.45);
  color: #7E9A9A;
}

.e-tags {
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #8C857A;
}

.body-card {
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.para {
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.85;
  letter-spacing: 0.02em;
  color: #2C2924;
}

.para + .para {
  margin-top: 22rpx;
}

.para.lead {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(25rpx * var(--fs, 1));
  color: #1F1D19;
  margin-bottom: 22rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(70, 58, 45, 0.08);
}

.section-head {
  margin-top: 34rpx;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.p-list {
  margin-top: 18rpx;
}

.p-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.p-thumb-wrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F3EFE6;
  border: 4rpx solid #FFFDF8;
  box-shadow: 0 6rpx 16rpx rgba(90, 70, 50, 0.10);
}

/* 底层默认图（本地时代细部，秒出）；上层远端专属图加载完淡入。
   aspectFill：任意比例远端图等比缩放铺满裁切，不拉伸变形。 */
.p-thumb-bg,
.p-thumb-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  filter: saturate(0.86) brightness(1.02);
}

.p-thumb-img {
  opacity: 0;
  transition: opacity 0.28s ease;
}

.p-thumb-img.on {
  opacity: 1;
}

.p-info {
  flex: 1;
  min-width: 0;
}

.p-name {
  display: block;
  margin-bottom: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(28rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.p-dates {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(20rpx * var(--fs, 1));
  color: #A9825E;
}

.p-dates.accent-modern {
  color: #7E9A9A;
}

.p-roles {
  display: block;
  margin-top: 6rpx;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #5F5A52;
}

.rel-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #A39A8E;
}

.foot-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.ghost-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(70, 58, 45, 0.14);
  border-radius: 38rpx;
  background: rgba(252, 251, 248, 0.6);
  font-size: calc(23rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #5F5A52;
}

.ghost-btn.on {
  border-color: rgba(163, 74, 62, 0.45);
  background: rgba(163, 74, 62, 0.06);
  color: #A34A3E;
}

.ghost-btn.on.on-modern {
  border-color: rgba(126, 154, 154, 0.5);
  background: rgba(126, 154, 154, 0.08);
  color: #5F7E7E;
}

.source-line {
  margin-top: 30rpx;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #A39A8E;
}
