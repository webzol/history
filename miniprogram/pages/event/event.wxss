.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.top-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #6D645A;
}

/* 古法篆刻印章 —— 不规则边框 + 透明底 + 朱砂文字 */
.top-seal {
  width: 44rpx;
  height: 48rpx;
  /* 不规则边框：用多重边框模拟篆刻刀痕的参差感 */
  border: 2rpx solid #8B4513;
  border-radius: 6rpx 10rpx 8rpx 12rpx;
  /* 透明底色，让宣纸透出 */
  background: transparent;
  /* 轻微旋转，模拟手工盖印的不规则 */
  transform: rotate(-3deg);
  display: flex;
  align-items: center;
  justify-content: center;
  /* 外发光模拟印泥洇散 */
  box-shadow:
    0 0 4rpx rgba(139, 69, 19, 0.12),
    0 0 10rpx rgba(139, 69, 19, 0.06);
}

.seal-char {
  font-family: "KaiTi", "STKaiti", "FangSong", "SimSun", serif;
  font-size: 22rpx;
  font-weight: bold;
  /* 朱砂印泥色（同「史载」印章） */
  color: #8B4513;
  /* 篆书效果：紧凑字距 */
  letter-spacing: 0.02em;
  /* 文字描边增强篆刻感 */
  text-shadow:
    0 0 1rpx #8B4513,
    0 0 2rpx rgba(139, 69, 19, 0.25);
  line-height: 1;
  /* 轻微压缩，模拟篆书方正感 */
  transform: scaleX(0.92);
}

.head-card {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 26rpx;
  margin-top: 26rpx;
  padding: 30rpx;
  border-radius: 38rpx;
  overflow: hidden;
  background: #FCFBF8;
  border-top: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.e-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.e-fig {
  width: 200rpx;
  height: 200rpx;
  flex: 0 0 200rpx;
  align-self: center;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F3EFE6;
  border: 4rpx solid #FFFDF8;
  box-shadow: 0 10rpx 24rpx rgba(90, 70, 50, 0.10);
}

.e-fig-img {
  width: 100%;
  height: 100%;
  display: block;
  filter: saturate(0.82) brightness(1.02);
}

.head-card.head-modern {
  border-top-color: rgba(126, 154, 154, 0.6);
}

.e-year {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #7D5A3B;
}

.head-modern .e-year {
  color: #4A6667;
}

.e-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(50rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  line-height: 1.25;
  color: #1F1D19;
}

.e-meta {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18rpx;
}

.era-chip {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(169, 130, 94, 0.35);
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #7D5A3B;
}

.era-chip.chip-modern {
  border-color: rgba(126, 154, 154, 0.45);
  color: #4A6667;
}

.e-tags {
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #6D645A;
}

.body-card {
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.para {
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.85;
  letter-spacing: 0.02em;
  color: #2C2924;
}

.para + .para {
  margin-top: 22rpx;
}

.para.lead {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(25rpx * var(--fs, 1));
  color: #1F1D19;
  margin-bottom: 22rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(70, 58, 45, 0.08);
}

.section-head {
  margin-top: 34rpx;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.p-list {
  margin-top: 18rpx;
}

.p-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.p-thumb-wrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F3EFE6;
  border: 4rpx solid #FFFDF8;
  box-shadow: 0 6rpx 16rpx rgba(90, 70, 50, 0.10);
}

/* 底层默认图（本地时代细部，秒出）；上层远端专属图加载完淡入。
   aspectFill：任意比例远端图等比缩放铺满裁切，不拉伸变形。 */
.p-thumb-bg,
.p-thumb-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  filter: saturate(0.86) brightness(1.02);
}

.p-thumb-img {
  opacity: 0;
  transition: opacity 0.28s ease;
}

.p-thumb-img.on {
  opacity: 1;
}

.p-info {
  flex: 1;
  min-width: 0;
}

.p-name {
  display: block;
  margin-bottom: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(28rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.p-dates {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(20rpx * var(--fs, 1));
  color: #7D5A3B;
}

.p-dates.accent-modern {
  color: #4A6667;
}

.p-roles {
  display: block;
  margin-top: 6rpx;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #5F5A52;
}

.rel-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #6D645A;
}

.foot-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.ghost-btn {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 6rpx 10rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(70, 58, 45, 0.14);
  border-radius: 38rpx;
  background: rgba(252, 251, 248, 0.6);
  font-size: calc(23rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #5F5A52;
}

.ghost-btn.on {
  border-color: rgba(163, 74, 62, 0.45);
  background: rgba(163, 74, 62, 0.06);
  color: #A34A3E;
}

.ghost-btn.on.on-modern {
  border-color: rgba(126, 154, 154, 0.5);
  background: rgba(126, 154, 154, 0.08);
  color: #4A6667;
}

.source-line {
  margin-top: 30rpx;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #6D645A;
}
