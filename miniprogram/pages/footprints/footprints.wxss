.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 56rpx;
  padding: 0 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.95) 0%, rgba(249, 244, 235, 0.88) 100%);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  overflow: hidden;
  transition: transform 0.12s ease, background 0.12s ease;
}

.back-pressed {
  transform: scale(0.97);
  background: rgba(244, 236, 224, 0.96);
}

.back-icon {
  position: relative;
  width: 32rpx;
  height: 20rpx;
  flex: 0 0 32rpx;
}

.back-chevron {
  position: absolute;
  left: 1rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.back-shaft {
  position: absolute;
  left: 7rpx;
  top: 9rpx;
  width: 22rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(138, 106, 62, 0.92), rgba(138, 106, 62, 0.62));
}

.back-divider {
  width: 1rpx;
  height: 18rpx;
  margin: 0 10rpx 0 5rpx;
  background: rgba(138, 106, 62, 0.20);
  flex: 0 0 1rpx;
}

.back-label {
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  text-indent: 0.08em;
  color: #6B5A33;
  white-space: nowrap;
}

.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8C857A;
}

.top-seal {
  position: absolute;
  right: 200rpx;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 44rpx;
  height: 50rpx;
  display: block;
  transform: rotate(2deg);
}

.head {
  margin-top: 26rpx;
  padding: 6rpx 4rpx 0;
}

.head-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(44rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.head-sub {
  display: block;
  margin-top: 12rpx;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #A39A8E;
}

.head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.clear-btn {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(70, 58, 45, 0.16);
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8C857A;
}

.list-card {
  margin-top: 26rpx;
  padding: 10rpx 28rpx 16rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.group + .group {
  margin-top: 8rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 22rpx 4rpx 8rpx;
}

.group-label {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8E5E36;
}

.group-count {
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #A39A8E;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid rgba(70, 58, 45, 0.07);
}

.row-thumb {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: block;
  border-radius: 18rpx;
  background: #F3EFE6;
  border: 3rpx solid #FFFDF8;
  box-shadow: 0 4rpx 10rpx rgba(90, 70, 50, 0.08);
  filter: saturate(0.86) brightness(1.02);
}

.row-thumb.row-thumb-modern {
  filter: saturate(0.7) brightness(1.03);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #8C857A;
}

.row-sub.sub-modern {
  color: #7E9A9A;
}

.row-when {
  flex: 0 0 auto;
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.02em;
  color: #A39A8E;
}

.hint-card {
  padding: 26rpx 28rpx;
}

.hint-text {
  display: block;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: calc(38rpx * var(--fs, 1));
  color: #8C857A;
}
