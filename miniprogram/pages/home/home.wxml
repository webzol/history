<view class="page">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen">
    <view class="topbar">
      <text class="brand">史页</text>
    </view>

    <view class="date">{{dateText}}</view>

    <view class="hero" bindtap="onHeroTap">
      <view class="hero-inner">
        <text class="hero-title">{{hero.title}}</text>
        <text class="hero-desc">{{hero.desc}}</text>
      </view>
      <image class="hero-art" src="/assets/palace.jpg" mode="widthFix"></image>
    </view>

    <view class="quick">
      <view class="quick-item t1" data-page="timeline" bindtap="goPage">
        <image class="quick-icon" src="/assets/icons/timeline-tile.png" mode="aspectFit"></image>
        <text class="quick-label">时间轴</text>
      </view>
      <view class="quick-item t2" data-page="dynasty" bindtap="goPage">
        <text class="quick-char">朝</text>
        <text class="quick-label">朝代</text>
      </view>
      <view class="quick-item t3" data-page="person" bindtap="goPage">
        <image class="quick-icon" src="/assets/icons/person.png" mode="aspectFit"></image>
        <text class="quick-label">人物</text>
      </view>
      <view class="quick-item t4" data-page="event" bindtap="goPage">
        <image class="quick-icon" src="/assets/icons/event.png" mode="aspectFit"></image>
        <text class="quick-label">事件</text>
      </view>
    </view>

    <view class="tih" wx:if="{{tih.length}}">
      <view class="tih-head">
        <text class="tih-title">历史上的今天</text>
        <text class="tih-sub">{{tihDate}}</text>
      </view>
      <view
        class="tih-item"
        wx:for="{{tih}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onTihTap"
      >
        <text class="tih-year">{{item.yearText}}</text>
        <text class="tih-tag {{item.type === '出生' ? 'tag-b' : item.type === '逝世' ? 'tag-d' : 'tag-e'}}">{{item.type}}</text>
        <view class="tih-main">
          <text class="tih-name">{{item.title}}</text>
          <text class="tih-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
      </view>
      <view class="tih-foot" wx:if="{{tihTotal > tih.length}}">共 {{tihTotal}} 条 · 点击条目看详情</view>
    </view>

    <view class="section-head">
      <text class="section-title">沿着时间走</text>
      <text class="section-link" bindtap="goDiscover">全部朝代 ›</text>
    </view>

    <view class="era-row">
      <view class="era-card" bindtap="onEraTap">
        <image class="era-bg" src="/assets/tang-bg.jpg" mode="aspectFill"></image>
        <view class="era-shade"></view>
        <text class="era-title">{{era.title}}</text>
        <text class="era-desc">{{era.desc}}</text>
      </view>
    </view>

    <view class="modern-card" bindtap="onModernTap">
      <view class="modern-copy">
        <text class="modern-kicker">{{modern.kicker}}</text>
        <text class="modern-title">{{modern.shortTitle}}</text>
        <text class="modern-desc">{{modern.desc}}</text>
      </view>
      <view class="modern-years">
        <text>1840</text>
        <view class="modern-dash"></view>
        <text>1949</text>
      </view>
    </view>
  </view>

  <view class="sheet-layer" wx:if="{{sheet.open}}">
    <view class="sheet-mask" bindtap="closeSheet"></view>
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-grip"></view>
      <view class="sheet-head">
        <text class="sheet-title">{{sheet.title}}</text>
        <text class="sheet-close" bindtap="closeSheet">×</text>
      </view>
      <view class="sheet-list">
        <view class="sheet-row" wx:for="{{sheet.list}}" wx:key="id" data-index="{{index}}" bindtap="onSheetItem">
          <view class="sheet-main">
            <text class="sheet-row-title">{{item.title}}</text>
            <text class="sheet-row-sub">{{item.sub}}</text>
          </view>
          <text class="sheet-row-arrow">›</text>
        </view>
      </view>
      <view class="sheet-cancel" bindtap="closeSheet">取消</view>
    </view>
  </view>
  <view class="sheet-layer" wx:if="{{info.open}}">
    <view class="sheet-mask" bindtap="closeInfo"></view>
    <view class="info-panel" catchtap="noop">
      <view class="sheet-grip"></view>
      <view class="sheet-head">
        <text class="sheet-title">{{info.title}}</text>
        <text class="sheet-close" bindtap="closeInfo">×</text>
      </view>
      <view class="info-body">
        <text class="info-para" wx:for="{{info.paragraphs}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="sheet-cancel" bindtap="closeInfo">知道了</view>
    </view>
  </view>
</view>
