.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 160rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 58rpx;
  font-weight: 400;
  letter-spacing: 0.10em;
  line-height: 1;
  color: #1F1D19;
}

.date {
  margin-top: 34rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.hero {
  position: relative;
  height: 412rpx;
  margin-top: 24rpx;
  border-radius: 42rpx;
  background: #FCFAFB;
  border: 1rpx solid rgba(80, 65, 48, 0.05);
  box-shadow: 0 28rpx 58rpx rgba(90, 70, 50, 0.08), 0 4rpx 12rpx rgba(90, 70, 50, 0.03);
  overflow: hidden;
}

.hero-inner {
  position: relative;
  z-index: 3;
  padding: 30rpx 30rpx 0;
}

.hero-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  font-weight: 400;
  letter-spacing: 0.08em;
  line-height: 1.1;
  color: #1F1D19;
}

.hero-desc {
  display: block;
  max-width: 600rpx;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.65;
  color: #5F5A52;
}

.hero-art {
  position: absolute;
  left: 0;
  bottom: 0;
  z-index: 1;
  width: 100%;
  height: auto;
  display: block;
}

.quick {
  display: flex;
  margin-top: 28rpx;
}

.quick-item {
  flex: 1;
  height: 168rpx;
  margin-right: 20rpx;
  border-radius: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.quick-item:last-child {
  margin-right: 0;
}

.quick-item.t1 {
  background: #EEF0F0;
}

.quick-item.t2 {
  background: #F1E8DD;
}

.quick-item.t3 {
  background: #F0F0F1;
}

.quick-item.t4 {
  background: #FBF9F6;
}

.quick-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
}

.quick-char {
  height: 54rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 58rpx;
  line-height: 1;
  color: #2A2722;
}

.quick-label {
  margin-top: 12rpx;
  font-size: 21rpx;
  letter-spacing: 0.04em;
  color: #3B3731;
}

.section-head {
  margin-top: 38rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.section-link {
  font-size: 19rpx;
  letter-spacing: 0.04em;
  color: #8C857A;
}

.era-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 20rpx;
}

.era-card {
  position: relative;
  flex: 1;
  height: 216rpx;
  padding: 26rpx 30rpx;
  border-radius: 38rpx;
  background: #F3EFE6;
  overflow: hidden;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.era-title {
  position: relative;
  z-index: 2;
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.era-desc {
  position: relative;
  z-index: 2;
  display: block;
  max-width: 350rpx;
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 19rpx;
  line-height: 1.55;
  color: #5F5A52;
}

.era-bg {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.era-shade {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 52%;
  background: linear-gradient(90deg, rgba(250, 247, 241, 0.42), rgba(250, 247, 241, 0));
  pointer-events: none;
}

.scroll-accent {
  flex: 0 0 56rpx;
  height: 216rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.05);
}

.scroll-accent-img {
  width: 100%;
  height: 100%;
  display: block;
}

.modern-card {
  position: relative;
  height: 200rpx;
  margin-top: 16rpx;
  padding: 28rpx 30rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}

.modern-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding-right: 150rpx;
}

.modern-kicker {
  display: block;
  font-size: 15rpx;
  letter-spacing: 0.12em;
  color: #7E9A9A;
}

.modern-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.05em;
  color: #1F1D19;
}

.modern-desc {
  display: block;
  max-width: 420rpx;
  margin-top: 9rpx;
  font-size: 19rpx;
  line-height: 1.55;
  color: #5F5A52;
}

.modern-years {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  line-height: 1.1;
  letter-spacing: 0.03em;
  color: #A9BCC4;
}

.modern-dash {
  width: 44rpx;
  height: 1rpx;
  margin: 8rpx 0;
  background: rgba(126, 154, 154, 0.55);
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  min-height: 128rpx;
  padding: 16rpx 20rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(250, 248, 243, 0.96);
  border-top: 1rpx solid rgba(70, 58, 45, 0.10);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: #7B746A;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  opacity: 0.52;
}

.tab.active {
  color: #211E1A;
}

.tab.active .tab-icon {
  opacity: 1;
}
