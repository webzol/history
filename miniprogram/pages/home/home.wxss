.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 160rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 58rpx;
  font-weight: 400;
  letter-spacing: 0.10em;
  line-height: 1;
  color: #1F1D19;
}

.date {
  margin-top: 34rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.hero {
  position: relative;
  height: 412rpx;
  margin-top: 24rpx;
  border-radius: 42rpx;
  background: #FCFAFB;
  border: 1rpx solid rgba(80, 65, 48, 0.05);
  box-shadow: 0 28rpx 58rpx rgba(90, 70, 50, 0.08), 0 4rpx 12rpx rgba(90, 70, 50, 0.03);
  overflow: hidden;
}

.hero-inner {
  position: relative;
  z-index: 3;
  padding: 30rpx 30rpx 0;
}

.hero-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  font-weight: 400;
  letter-spacing: 0.08em;
  line-height: 1.1;
  color: #1F1D19;
}

.hero-desc {
  display: block;
  max-width: 600rpx;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.65;
  color: #5F5A52;
}

.hero-art {
  position: absolute;
  left: 0;
  bottom: 0;
  z-index: 1;
  width: 100%;
  height: auto;
  display: block;
}

.quick {
  display: flex;
  margin-top: 28rpx;
}

.quick-item {
  flex: 1;
  height: 168rpx;
  margin-right: 20rpx;
  border-radius: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.quick-item:last-child {
  margin-right: 0;
}

.quick-item.t1 {
  background: #EEF0F0;
}

.quick-item.t2 {
  background: #F1E8DD;
}

.quick-item.t3 {
  background: #F0F0F1;
}

.quick-item.t4 {
  background: #FBF9F6;
}

.quick-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
}

.quick-char {
  height: 54rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 58rpx;
  line-height: 1;
  color: #2A2722;
}

.quick-label {
  margin-top: 12rpx;
  font-size: 21rpx;
  letter-spacing: 0.04em;
  color: #3B3731;
}

/* 「历史上的今天」——60s API 实时板块 */
.tih {
  margin-top: 34rpx;
  padding: 28rpx 30rpx 6rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  border: 1rpx solid rgba(80, 65, 48, 0.05);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.tih-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tih-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.tih-sub {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 19rpx;
  letter-spacing: 0.04em;
  color: #8C857A;
}

.tih-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 22rpx 0 20rpx;
  border-top: 1rpx solid rgba(31, 29, 25, 0.05);
}

.tih-year {
  flex: none;
  width: 128rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  line-height: 34rpx;
  color: #A34A3E;
}

.tih-tag {
  flex: none;
  height: 32rpx;
  padding: 0 10rpx;
  margin-top: 1rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 32rpx;
  letter-spacing: 0.04em;
}

.tag-e { background: #F1E8DD; color: #5F5A52; }
.tag-b { background: #EEF0F0; color: #5F5A52; }
.tag-d { background: #F0F0F1; color: #8C857A; }

.tih-main {
  flex: 1;
  min-width: 0;
}

.tih-name {
  display: block;
  font-size: 23rpx;
  line-height: 34rpx;
  color: #1F1D19;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tih-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #8C857A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tih-foot {
  padding: 18rpx 0 20rpx;
  border-top: 1rpx solid rgba(31, 29, 25, 0.05);
  font-size: 19rpx;
  letter-spacing: 0.04em;
  color: #8C857A;
}

.section-head {
  margin-top: 38rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.section-link {
  font-size: 19rpx;
  letter-spacing: 0.04em;
  color: #8C857A;
}

.era-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 20rpx;
}

.era-card {
  position: relative;
  flex: 1;
  height: 216rpx;
  padding: 26rpx 30rpx;
  border-radius: 38rpx;
  background: #F3EFE6;
  overflow: hidden;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.era-title {
  position: relative;
  z-index: 2;
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.era-desc {
  position: relative;
  z-index: 2;
  display: block;
  max-width: 350rpx;
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 19rpx;
  line-height: 1.55;
  color: #5F5A52;
}

.era-bg {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.era-shade {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 52%;
  background: linear-gradient(90deg, rgba(250, 247, 241, 0.42), rgba(250, 247, 241, 0));
  pointer-events: none;
}

.modern-card {
  position: relative;
  height: 200rpx;
  margin-top: 16rpx;
  padding: 28rpx 30rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}

.modern-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding-right: 150rpx;
}

.modern-kicker {
  display: block;
  font-size: 15rpx;
  letter-spacing: 0.12em;
  color: #7E9A9A;
}

.modern-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.05em;
  color: #1F1D19;
}

.modern-desc {
  display: block;
  max-width: 420rpx;
  margin-top: 9rpx;
  font-size: 19rpx;
  line-height: 1.55;
  color: #5F5A52;
}

.modern-years {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  line-height: 1.1;
  letter-spacing: 0.03em;
  color: #A9BCC4;
}

.modern-dash {
  width: 44rpx;
  height: 1rpx;
  margin: 8rpx 0;
  background: rgba(126, 154, 154, 0.55);
}

/* 磁贴选择弹层（自绘底部面板，替换原生 ActionSheet） */
.sheet-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
}

.sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 29, 25, 0.3);
  animation: sheetFade 0.18s ease both;
}

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 62vh;
  padding: 16rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #FCFBF8;
  border-radius: 42rpx 42rpx 0 0;
  box-shadow: 0 -24rpx 52rpx rgba(90, 70, 50, 0.16);
  animation: sheetUp 0.24s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.sheet-grip {
  width: 66rpx;
  height: 6rpx;
  margin: 4rpx auto 14rpx;
  border-radius: 3rpx;
  background: #E6E0D4;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 8rpx 16rpx;
  border-bottom: 1rpx solid rgba(31, 29, 25, 0.06);
}

.sheet-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 33rpx;
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.sheet-close {
  font-size: 40rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  color: #8C857A;
}

.sheet-list {
  max-height: 44vh;
  overflow-y: auto;
}

.sheet-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(31, 29, 25, 0.05);
}

.sheet-main {
  flex: 1;
  min-width: 0;
}

.sheet-row-title {
  display: block;
  font-size: 26rpx;
  color: #1F1D19;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8C857A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-row-arrow {
  font-size: 30rpx;
  color: #C9C2B6;
}

.sheet-cancel {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #EEF0F0;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: #5F5A52;
  text-align: center;
  line-height: 84rpx;
}

@keyframes sheetFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetUp {
  from { transform: translateY(42%); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}
