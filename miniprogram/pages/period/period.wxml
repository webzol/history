<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen" wx:if="{{period}}">
    <view class="topbar">
      <view class="back" bindtap="goBack">
        <image class="back-arrow" src="/assets/back-arrow.png" mode="aspectFit"></image>
        <text class="back-label">返回</text>
      </view>
      <text class="top-title">史页 · 朝代</text>
      <text class="top-seal {{period.id === 'modern' ? 'seal-modern' : ''}}">{{seal}}</text>
    </view>

    <view class="head-card {{period.id === 'modern' ? 'head-modern' : ''}}">
      <view class="hero-band">
        <image class="hero-img" src="{{period.img}}" mode="aspectFill"></image>
        <view class="hero-shade"></view>
        <view class="hero-copy">
          <text class="p-name">{{period.name}}</text>
          <text class="p-years">{{period.yearText}}</text>
        </view>
        <text class="hero-title">{{period.title}}</text>
      </view>
      <text class="p-desc">{{period.desc}}</text>
    </view>

    <view class="body-card" wx:if="{{span}}">
      <view class="para">
        <text>{{span}}，共录史事 {{events.length}} 条；点击下方条目可看正文与史料。</text>
      </view>
    </view>

    <view class="foot-actions" wx:if="{{!events.length}}">
      <view class="time-btn" bindtap="goTimeline">
        <text>进时间轴看这个时代的脉络</text>
      </view>
    </view>

    <view class="section-head" wx:if="{{events.length}}">
      <text class="section-title">这个时代的史事</text>
      <text class="section-count">{{events.length}} 条</text>
    </view>
    <view class="rel-list" wx:if="{{events.length}}">
      <view
        wx:for="{{events}}"
        wx:key="id"
        class="rel-card"
        data-id="{{item.id}}"
        bindtap="goEvent"
      >
        <text class="rel-year {{period.id === 'modern' ? 'accent-modern' : ''}}">{{item.yearText}}</text>
        <view class="rel-body">
          <text class="rel-title">{{item.title}}</text>
          <text class="rel-desc">{{item.desc}}</text>
        </view>
        <text class="rel-arrow">›</text>
      </view>
    </view>

    <view class="source-line">史料 · {{period.source}}</view>
  </view>
</view>
