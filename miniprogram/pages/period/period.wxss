.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 56rpx;
  padding: 0 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.95) 0%, rgba(249, 244, 235, 0.88) 100%);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  overflow: hidden;
  transition: transform 0.12s ease, background 0.12s ease;
}

.back-pressed {
  transform: scale(0.97);
  background: rgba(244, 236, 224, 0.96);
}

.back-icon {
  position: relative;
  width: 32rpx;
  height: 20rpx;
  flex: 0 0 32rpx;
}

.back-chevron {
  position: absolute;
  left: 1rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.back-shaft {
  position: absolute;
  left: 7rpx;
  top: 9rpx;
  width: 22rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(138, 106, 62, 0.92), rgba(138, 106, 62, 0.62));
}

.back-divider {
  width: 1rpx;
  height: 18rpx;
  margin: 0 10rpx 0 5rpx;
  background: rgba(138, 106, 62, 0.20);
  flex: 0 0 1rpx;
}

.back-label {
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  text-indent: 0.08em;
  color: #6B5A33;
  white-space: nowrap;
}

.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8C857A;
}

/* 古法篆刻印章 —— 不规则边框 + 透明底 + 朱砂文字 */
.top-seal {
  position: absolute;
  right: 200rpx;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 44rpx;
  height: 48rpx;
  /* 不规则边框：用多重边框模拟篆刻刀痕的参差感 */
  border: 2rpx solid #8B4513;
  border-radius: 6rpx 10rpx 8rpx 12rpx;
  /* 透明底色，让宣纸透出 */
  background: transparent;
  /* 轻微旋转，模拟手工盖印的不规则 */
  transform: rotate(-3deg);
  display: flex;
  align-items: center;
  justify-content: center;
  /* 外发光模拟印泥洇散 */
  box-shadow:
    0 0 4rpx rgba(139, 69, 19, 0.12),
    0 0 10rpx rgba(139, 69, 19, 0.06);
}

.seal-char {
  font-family: "KaiTi", "STKaiti", "FangSong", "SimSun", serif;
  font-size: 22rpx;
  font-weight: bold;
  /* 朱砂印泥色（同「史载」印章） */
  color: #8B4513;
  /* 篆书效果：紧凑字距 */
  letter-spacing: 0.02em;
  /* 文字描边增强篆刻感 */
  text-shadow:
    0 0 1rpx #8B4513,
    0 0 2rpx rgba(139, 69, 19, 0.25);
  line-height: 1;
  /* 轻微压缩，模拟篆书方正感 */
  transform: scaleX(0.92);
}

.head-card {
  margin-top: 26rpx;
  padding: 24rpx 24rpx 34rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  border-top: 6rpx solid rgba(169, 130, 94, 0.55);
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.head-card.head-modern {
  border-top-color: rgba(126, 154, 154, 0.6);
}

.hero-band {
  position: relative;
  height: 300rpx;
  border-radius: 30rpx;
  overflow: hidden;
}

.hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hero-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(30, 26, 20, 0.06) 30%, rgba(30, 26, 20, 0.5));
}

.hero-copy {
  position: absolute;
  left: 28rpx;
  bottom: 24rpx;
  z-index: 2;
}

.p-name {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(52rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  line-height: 1.1;
  color: #FCFBF8;
}

.p-years {
  display: block;
  margin-top: 10rpx;
  font-size: calc(21rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: rgba(252, 251, 248, 0.86);
}

.hero-title {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 2;
  height: 44rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 22rpx;
  background: rgba(252, 251, 248, 0.92);
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #5F5A52;
}

.p-desc {
  display: block;
  margin-top: 24rpx;
  padding: 0 10rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.7;
  letter-spacing: 0.02em;
  color: #5F5A52;
}

.body-card {
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.para {
  font-size: calc(23rpx * var(--fs, 1));
  line-height: 1.85;
  letter-spacing: 0.02em;
  color: #2C2924;
}

.para + .para {
  margin-top: 22rpx;
}

.para.lead {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(25rpx * var(--fs, 1));
  color: #1F1D19;
}

.section-head {
  margin-top: 34rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.section-count {
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #8C857A;
}

.rel-list {
  margin-top: 18rpx;
}

.rel-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.rel-year {
  flex: 0 0 auto;
  white-space: nowrap;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(21rpx * var(--fs, 1));
  letter-spacing: 0.02em;
  color: #A9825E;
}

.rel-year.accent-modern {
  color: #7E9A9A;
}

.rel-body {
  flex: 1;
  min-width: 0;
}

.rel-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(25rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.rel-desc {
  display: block;
  margin-top: 8rpx;
  font-size: calc(20rpx * var(--fs, 1));
  line-height: 1.6;
  color: #8C857A;
}

.rel-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #A39A8E;
}

.source-line {
  margin-top: 30rpx;
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #A39A8E;
}

.foot-actions {
  margin-top: 30rpx;
}

.time-btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(70, 58, 45, 0.14);
  border-radius: 38rpx;
  background: rgba(252, 251, 248, 0.6);
  font-size: calc(23rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #5F5A52;
}
