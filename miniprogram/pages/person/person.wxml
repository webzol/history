<view class="page fs-{{fontClass}}">
  <image aria-hidden="true" class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen" wx:if="{{person}}" aria-hidden="{{share.open}}">
    <view class="topbar">
      <view class="back-hit" bindtap="goBack" aria-role="button" aria-label="返回上一页"
        hover-class="back-hit-pressed" hover-stay-time="80">
        <view class="back" aria-hidden="true">
          <view class="back-icon">
            <view class="back-chevron"></view>
            <view class="back-shaft"></view>
          </view>
          <view class="back-divider"></view>
          <text class="back-label">返回</text>
        </view>
      </view>
      <text class="top-title">人物</text>
      <view class="top-seal" aria-hidden="true">
        <text class="seal-char">{{seal}}</text>
      </view>
    </view>

    <view class="head-card">
      <image aria-hidden="true" class="p-bg" wx:if="{{headImg}}" src="{{headImg}}" mode="aspectFit" binderror="onHeadImgErr"></image>
      <view class="p-veil" aria-hidden="true"></view>
      <view class="p-copy">
        <text class="p-name" aria-role="heading">{{person.name}}</text>
        <view class="p-meta">
          <text class="p-dates {{accent === 'modern' ? 'accent-modern' : ''}}">{{person.dates}}</text>
          <text class="p-dot" aria-hidden="true">·</text>
          <text class="p-roles">{{person.roles}}</text>
        </view>
        <view class="era-chip {{accent === 'modern' ? 'chip-modern' : ''}}">
          <text>{{person.era}}</text>
        </view>
        <view class="quote-block" wx:if="{{person.quote}}">
          <text class="quote-mark" aria-hidden="true">“</text>
          <text class="quote">{{person.quote}}</text>
          <text class="quote-src">——{{person.quoteSource}}</text>
        </view>
      </view>
    </view>

    <view class="body-card">
      <view class="para" wx:for="{{person.details}}" wx:key="*this">
        <text>{{item}}</text>
      </view>
    </view>

    <view class="section-head" wx:if="{{related.length}}">
      <text class="section-title" aria-role="heading">生平际会 · 相关史事</text>
    </view>
    <view class="rel-list" wx:if="{{related.length}}">
      <view
        wx:for="{{related}}"
        wx:key="id"
        class="rel-card"
        data-id="{{item.id}}"
        bindtap="goEvent" aria-role="button" aria-label="{{item.title + '，' + item.yearText + '。' + item.desc}}"
      >
        <text class="rel-year {{accent === 'modern' && item.mode === 'modern' ? 'accent-modern' : ''}}">{{item.yearText}}</text>
        <view class="rel-body">
          <text class="rel-title">{{item.title}}</text>
          <text class="rel-desc">{{item.desc}}</text>
        </view>
        <image aria-hidden="true" class="rel-thumb" wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" lazy-load binderror="onRelImgErr" data-id="{{item.id}}"></image>
        <text class="rel-arrow" aria-hidden="true">›</text>
      </view>
    </view>

    <view class="foot-actions">
      <view class="ghost-btn {{collected ? (accent === 'modern' ? 'on on-modern' : 'on') : ''}}" bindtap="toggleCollect" aria-role="button" aria-label="{{collected ? '已收藏此人物，取消收藏' : '收藏此人物'}}">
        <text>{{collected ? '✓ 已收藏此人物' : '收藏此人物'}}</text>
      </view>
      <view class="ghost-btn" bindtap="openShare" aria-role="button" aria-label="打开分享卡片">
        <text>共此卷</text>
      </view>
    </view>

    <view class="source-line">史料 · {{person.source}}</view>

  </view>

    <view class="ss-layer" wx:if="{{share.open}}">
      <view class="ss-mask" aria-hidden="true" bindtap="closeShare"></view>
      <view class="ss-panel" aria-role="dialog" aria-modal="true" aria-label="分享卡片">
        <view class="ss-grip"></view>
        <view class="ss-head">
          <text class="ss-title">共此卷</text>
          <text class="ss-close ss-close-touch" bindtap="closeShare" aria-role="button" aria-label="关闭分享卡片">×</text>
        </view>
        <view class="ss-qr-wrap" aria-hidden="true">
          <image aria-hidden="true" wx:if="{{share.fallback}}" class="ss-canvas" src="/assets/share-fallback.jpg" mode="aspectFill"></image>
          <canvas wx:else type="2d" id="ssQrCanvas" class="ss-canvas" disable-scroll="true"></canvas>
        </view>
        <view class="ss-actions">
          <button class="ss-btn ss-btn-primary" open-type="share" aria-label="发送给好友">转 寄 好 友</button>
          <view class="ss-btn ss-btn-ghost" bindtap="saveQr" aria-role="button" aria-label="保存分享卡片">保 存 卡 片</view>
        </view>
      </view>
    </view>
</view>

<feedback-popup></feedback-popup>
<privacy-popup></privacy-popup>
