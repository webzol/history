.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  line-height: 1;
  color: #1F1D19;
}

.top-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: #8C857A;
}

.top-seal {
  width: 44rpx;
  height: 50rpx;
  background: #A34A3E;
  color: #FFF8EF;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(2deg);
}

.top-seal.seal-modern {
  background: #7E9A9A;
}

.head-card {
  position: relative;
  margin-top: 26rpx;
  padding: 40rpx 34rpx 34rpx;
  border-radius: 38rpx;
  overflow: hidden;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.p-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.46;
  filter: saturate(0.6) brightness(1.04);
}

.p-veil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(252, 251, 248, 0.36) 0%, rgba(252, 251, 248, 0.78) 48%, rgba(252, 251, 248, 0.95) 100%);
}

.p-copy {
  position: relative;
  z-index: 2;
}

.p-name {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 64rpx;
  letter-spacing: 0.08em;
  line-height: 1.2;
  color: #1F1D19;
}

.p-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.p-dates {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: #A9825E;
}

.p-dates.accent-modern {
  color: #7E9A9A;
}

.p-dot {
  color: #8C857A;
}

.p-roles {
  font-size: 24rpx;
  letter-spacing: 0.03em;
  color: #5F5A52;
}

.era-chip {
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(169, 130, 94, 0.35);
  font-size: 19rpx;
  letter-spacing: 0.06em;
  color: #A9825E;
}

.era-chip.chip-modern {
  border-color: rgba(126, 154, 154, 0.45);
  color: #7E9A9A;
}

.quote-block {
  margin-top: 28rpx;
  padding: 26rpx 26rpx 24rpx;
  border-left: 4rpx solid rgba(163, 74, 62, 0.4);
  background: rgba(252, 251, 248, 0.72);
  border-radius: 0 24rpx 24rpx 0;
}

.quote-mark {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 40rpx;
  line-height: 0.6;
  color: #A39A8E;
}

.quote {
  display: block;
  margin-top: 8rpx;
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1F1D19;
}

.quote-src {
  display: block;
  margin-top: 12rpx;
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 20rpx;
  color: #8C857A;
  text-align: right;
}

.body-card {
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.para {
  font-size: 23rpx;
  line-height: 1.85;
  letter-spacing: 0.02em;
  color: #2C2924;
}

.para + .para {
  margin-top: 22rpx;
}

.section-head {
  margin-top: 34rpx;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.rel-list {
  margin-top: 18rpx;
}

.rel-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.04);
}

.rel-year {
  width: 130rpx;
  flex: 0 0 130rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 22rpx;
  color: #A9825E;
}

.rel-year.accent-modern {
  color: #7E9A9A;
}

.rel-body {
  flex: 1;
  min-width: 0;
}

.rel-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.rel-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.55;
  color: #5F5A52;
}

.rel-thumb {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  display: block;
  border-radius: 18rpx;
  background: #F3EFE6;
  border: 1rpx solid rgba(70, 58, 45, 0.08);
  filter: saturate(0.88) brightness(1.01);
}

.rel-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  color: #A39A8E;
}

.foot-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.ghost-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(70, 58, 45, 0.14);
  border-radius: 38rpx;
  background: rgba(252, 251, 248, 0.6);
  font-size: 23rpx;
  letter-spacing: 0.05em;
  color: #5F5A52;
}

.ghost-btn.on {
  border-color: rgba(163, 74, 62, 0.45);
  background: rgba(163, 74, 62, 0.06);
  color: #A34A3E;
}

.ghost-btn.on.on-modern {
  border-color: rgba(126, 154, 154, 0.5);
  background: rgba(126, 154, 154, 0.08);
  color: #5F7E7E;
}

.source-line {
  margin-top: 30rpx;
  font-size: 19rpx;
  letter-spacing: 0.03em;
  color: #A39A8E;
}
