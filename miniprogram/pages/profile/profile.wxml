<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen">
    <view class="topbar">
      <text class="brand">我的</text>
    </view>

    <view class="head-card">
      <view class="avatar-wrap">
        <image class="avatar" src="/assets/avatar-scholar.png" mode="aspectFill"></image>
      </view>
      <view class="head-info">
        <text class="nick">史页客</text>
        <text class="tagline">以千年为卷轴，读万古事</text>
      </view>
      <image class="head-seal" src="/assets/seal.png" mode="aspectFit"></image>
    </view>

    <view class="stats-card">
      <view class="stat" wx:for="{{stats}}" wx:key="key">
        <text class="stat-num">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <view class="pref-card">
      <view class="pref-head">
        <text class="pref-title">阅读设置</text>
        <text class="pref-note">全站文字</text>
      </view>
      <view class="seg">
        <view
          wx:for="{{fontOptions}}"
          wx:key="key"
          class="seg-item {{fontKey === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFontPick"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
      <text class="pref-preview">一页一页，读千年史事。</text>
    </view>

    <view class="plate-card" bindtap="onAboutBanner">
      <view class="plate-frame">
        <image class="plate-img" src="/assets/paintings/landscape.jpg" mode="aspectFill"></image>
      </view>
      <view class="plate-cap">
        <text class="plate-title">千古长卷</text>
        <text class="plate-sub">王希孟《千里江山图》卷 · 故宫博物院藏</text>
      </view>
    </view>

    <view class="list-card hint-card" wx:if="{{!favs.length}}">
      <text class="hint-text">还没有收藏。在人物、史事详情页点「收藏」，就会出现在这里。</text>
    </view>
    <view class="list-card" wx:if="{{favs.length}}">
      <view class="list-head">
        <text class="list-title">我的收藏</text>
        <text class="list-count">{{favCount}} 条</text>
      </view>
      <view
        class="list-row"
        wx:for="{{favsShow}}"
        wx:key="id"
        data-type="{{item.type}}"
        data-id="{{item.id}}"
        bindtap="onEntry"
        bindlongpress="onFavLongPress"
      >
        <image class="row-thumb {{item.modern ? 'row-thumb-modern' : ''}}" src="{{item.img}}" mode="aspectFill"></image>
        <view class="row-main">
          <text class="row-title">{{item.title}}</text>
          <text class="row-sub {{item.modern ? 'sub-modern' : ''}}">{{item.sub}}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view class="list-fold" wx:if="{{favHasMore}}" bindtap="onAllFavs">
        <text class="fold-text">查看全部收藏</text>
        <text class="fold-count">{{favCount}} 条</text>
        <text class="fold-arrow">›</text>
      </view>
    </view>

    <view class="list-card hint-card" wx:if="{{!foots.length}}">
      <text class="hint-text">还没有足迹。浏览人物、史事、朝代详情页后会留下足迹。</text>
    </view>
    <view class="list-card" wx:if="{{foots.length}}">
      <view class="list-head">
        <text class="list-title">浏览足迹</text>
        <text class="list-count">{{footCount}} 条</text>
      </view>
      <view
        class="list-row"
        wx:for="{{footsShow}}"
        wx:key="id"
        data-type="{{item.type}}"
        data-id="{{item.id}}"
        bindtap="onEntry"
      >
        <image class="row-thumb {{item.modern ? 'row-thumb-modern' : ''}}" src="{{item.img}}" mode="aspectFill"></image>
        <view class="row-main">
          <text class="row-title">{{item.title}}</text>
          <text class="row-sub {{item.modern ? 'sub-modern' : ''}}">{{item.sub}}</text>
        </view>
        <text class="row-when">{{item.when}}</text>
      </view>
      <view class="list-fold" wx:if="{{footHasMore}}" bindtap="onAllFoots">
        <text class="fold-text">查看全部足迹</text>
        <text class="fold-count">{{footCount}} 条</text>
        <text class="fold-arrow">›</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-row" bindtap="onSearch">
        <text class="menu-label">搜索史事 · 人物</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onCheckUpdate">
        <text class="menu-label">检查内容更新</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onDataNote">
        <text class="menu-label">数据与史料说明</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onAssetNote">
        <text class="menu-label">素材与授权说明</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onAbout">
        <text class="menu-label">关于史页</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row last" bindtap="onClearCache">
        <text class="menu-label">清除缓存</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="sheet-layer" wx:if="{{info.open}}">
    <view class="sheet-mask" bindtap="closeInfo"></view>
    <view class="info-panel" catchtap="noop">
      <view class="sheet-grip"></view>
      <view class="sheet-head">
        <text class="sheet-title">{{info.title}}</text>
        <text class="sheet-close" bindtap="closeInfo">×</text>
      </view>
      <view class="info-body">
        <text class="info-para" wx:for="{{info.paragraphs}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="sheet-cancel" bindtap="closeInfo">知道了</view>
    </view>
  </view>

</view>
