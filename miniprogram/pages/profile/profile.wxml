<view class="page">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen">
    <view class="topbar">
      <text class="brand">我的</text>
    </view>

    <view class="head-card">
      <view class="avatar-wrap">
        <image class="avatar" src="/assets/paintings/landscape.jpg" mode="aspectFill"></image>
      </view>
      <view class="head-info">
        <text class="nick">史页客</text>
        <text class="tagline">以千年为卷轴，读万古事</text>
      </view>
      <text class="head-seal">史</text>
    </view>

    <view class="stats-card">
      <view class="stat" wx:for="{{stats}}" wx:key="key">
        <text class="stat-num">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <view class="banner-card" bindtap="onAboutBanner">
      <image class="banner-bg" src="/assets/paintings/landscape.jpg" mode="aspectFill"></image>
      <view class="banner-shade"></view>
      <text class="banner-title">千古长卷</text>
      <text class="banner-sub">王希孟《千里江山图》卷 · 故宫博物院藏</text>
    </view>

    <view class="list-card hint-card" wx:if="{{!favs.length}}">
      <text class="hint-text">还没有收藏。在人物、史事详情页点「收藏」，就会出现在这里。</text>
    </view>
    <view class="list-card" wx:if="{{favs.length}}">
      <view class="list-head">
        <text class="list-title">我的收藏</text>
        <text class="list-count">{{favCount}} 条</text>
      </view>
      <view
        class="list-row"
        wx:for="{{favs}}"
        wx:key="id"
        data-type="{{item.type}}"
        data-id="{{item.id}}"
        bindtap="onEntry"
      >
        <text class="row-char {{item.modern ? 'row-modern' : ''}}">{{item.type === 'person' ? '人' : '事'}}</text>
        <view class="row-main">
          <text class="row-title">{{item.title}}</text>
          <text class="row-sub {{item.modern ? 'sub-modern' : ''}}">{{item.sub}}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="list-card hint-card" wx:if="{{!foots.length}}">
      <text class="hint-text">还没有足迹。浏览人物、史事、朝代详情页后会留下足迹。</text>
    </view>
    <view class="list-card" wx:if="{{foots.length}}">
      <view class="list-head">
        <text class="list-title">浏览足迹</text>
        <text class="list-count">{{footCount}} 条</text>
      </view>
      <view
        class="list-row"
        wx:for="{{foots}}"
        wx:key="id"
        data-type="{{item.type}}"
        data-id="{{item.id}}"
        bindtap="onEntry"
      >
        <text class="row-char {{item.modern ? 'row-modern' : ''}}">{{item.type === 'person' ? '人' : '事'}}</text>
        <view class="row-main">
          <text class="row-title">{{item.title}}</text>
          <text class="row-sub {{item.modern ? 'sub-modern' : ''}}">{{item.sub}}</text>
        </view>
        <text class="row-when">{{item.when}}</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-row" bindtap="onSearch">
        <text class="menu-label">搜索史事 · 人物</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onDataNote">
        <text class="menu-label">数据与史料说明</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onAssetNote">
        <text class="menu-label">素材与授权说明</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onAbout">
        <text class="menu-label">关于史页</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row last" bindtap="onClearCache">
        <text class="menu-label">清除缓存</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="tabbar">
    <view class="tab" data-page="home" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/home.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="tab" data-page="timeline" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/timeline.png" mode="aspectFit"></image>
      <text>时间轴</text>
    </view>
    <view class="tab" data-page="discover" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/discover.png" mode="aspectFit"></image>
      <text>发现</text>
    </view>
    <view class="tab active" data-page="profile" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/profile.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
