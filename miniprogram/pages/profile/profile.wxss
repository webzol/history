.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 160rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(54rpx * var(--fs, 1));
  font-weight: 400;
  letter-spacing: 0.08em;
  color: #1F1D19;
}

/* 用户头卡 */
.head-card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 38rpx;
  background: linear-gradient(106deg, #FCFBF8 55%, var(--season-wash, #FCFBF8));
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #F3EFE6;
  border: 4rpx solid #FFFDF8;
  box-shadow: 0 0 0 2rpx var(--season-line, #E8E1D7), 0 8rpx 20rpx rgba(90, 70, 50, 0.12);
}

.avatar {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.avatar-pressed .avatar { opacity: 0.82; }

.avatar-season {
  position: absolute;
  right: -7rpx;
  bottom: -6rpx;
  width: 37rpx;
  height: 37rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #FCFBF8;
  border-radius: 50%;
  color: #FCFBF8;
  background: var(--season-ink, #6D645A);
  font-family: "KaiTi", "STKaiti", serif;
  font-size: calc(21rpx * var(--fs, 1));
  line-height: 1;
}

.head-info {
  position: relative;
  flex: 1;
  min-width: 0;
}

.season-spring { --season-wash: #F3F2E6; --season-line: #D0D4B8; --season-ink: #586744; }
.season-summer { --season-wash: #E8F0EB; --season-line: #B6CAC1; --season-ink: #456660; }
.season-autumn { --season-wash: #F3E7D5; --season-line: #DAC19A; --season-ink: #795136; }
.season-winter { --season-wash: #E9EFF0; --season-line: #B9CAD0; --season-ink: #45616B; }

.season-art {
  position: absolute;
  right: 12rpx;
  bottom: -15rpx;
  width: 170rpx;
  height: 108rpx;
  pointer-events: none;
  opacity: 0.68;
}

.identity-enter .avatar-wrap::before {
  content: '';
  position: absolute;
  inset: -5rpx;
  border: 3rpx solid var(--season-ink, #6D645A);
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  animation: avatar-ring-in 540ms ease-out;
}

.identity-enter .season-art {
  transform-origin: right bottom;
  animation: season-art-in 640ms ease-out;
}

@keyframes avatar-ring-in {
  0% { opacity: 0.2; transform: scale(0.98); }
  30% { opacity: 0.62; }
  100% { opacity: 0; transform: scale(1.09); }
}

@keyframes season-art-in {
  from { opacity: 0.16; transform: translateY(12rpx) rotate(-6deg); }
  to { opacity: 0.68; transform: translateY(0) rotate(0); }
}

@media (prefers-reduced-motion: reduce) {
  .identity-enter .avatar-wrap::before,
  .identity-enter .season-art { animation: none; }
}

.season-stem, .season-motif { position: absolute; }
.season-stem {
  width: 112rpx;
  height: 45rpx;
  bottom: 11rpx;
  right: 10rpx;
  border-top: 2rpx solid var(--season-line);
  border-radius: 60% 0 0;
  transform: rotate(-27deg);
}

.season-motif { right: 44rpx; bottom: 27rpx; width: 49rpx; height: 38rpx; }
.season-motif-small { right: 7rpx; bottom: 42rpx; transform: scale(0.65) rotate(28deg); }

/* 桃花、荷叶、银杏与雪枝沿卡片右下角留白展开。 */
.season-spring .season-motif {
  background: radial-gradient(ellipse at 50% 53%, #B88268 7%, transparent 10%),
    radial-gradient(ellipse at 49% 24%, #E2A997 0 19%, transparent 22%),
    radial-gradient(ellipse at 27% 60%, #E4BAA9 0 20%, transparent 23%),
    radial-gradient(ellipse at 69% 61%, #DFAD9E 0 20%, transparent 23%),
    radial-gradient(ellipse at 50% 75%, #E8BFAD 0 17%, transparent 20%);
}

.season-summer .season-motif {
  border-radius: 58% 44% 52% 38%;
  background: radial-gradient(ellipse at 44% 65%, #7DA99B 0 6%, transparent 9%),
    repeating-conic-gradient(from 8deg at 44% 65%, #A1C4B5 0 16deg, #BBD3C9 16deg 39deg);
  transform: rotate(-18deg);
}

.season-summer .season-motif-small { transform: scale(0.63) rotate(24deg); }
.season-summer .season-stem { transform: rotate(-5deg); border-radius: 50%; border-bottom: 2rpx solid var(--season-line); }

.season-autumn .season-motif {
  border-radius: 80% 80% 14% 14%;
  background: repeating-conic-gradient(from -47deg at 50% 100%, #CF9F5E 0 7deg, #E0BD84 7deg 18deg);
  transform: rotate(-31deg);
}

.season-autumn .season-motif-small { transform: scale(0.64) rotate(23deg); }
.season-winter .season-art {
  background: radial-gradient(circle at 28% 39%, #A5BBC4 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 54% 24%, #AAC1CA 0 3rpx, transparent 4rpx),
    radial-gradient(circle at 86% 29%, #94ACB8 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 80% 48%, #FAFDFF 0 5rpx, transparent 7rpx);
}

.season-winter .season-motif {
  border-top: 3rpx solid #FCFDFF;
  border-radius: 80% 0 0;
  transform: rotate(-34deg);
}

.season-winter .season-motif-small { transform: scale(0.68) rotate(19deg); }

.nick-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.nick {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(36rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.tagline {
  display: block;
  margin-top: 10rpx;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #6D645A;
}

.nick-refresh {
  position: relative;
  flex-shrink: 0;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.1em;
  color: #A34A3E;
  background: rgba(163, 74, 62, 0.06);
  border: 2rpx solid rgba(163, 74, 62, 0.55);
  border-radius: 8rpx;
  padding: 5rpx 12rpx 5rpx 14rpx;
}

/* 印章双框：内圈细线 */
.nick-refresh::after {
  content: '';
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  left: 2rpx;
  border: 1rpx solid rgba(163, 74, 62, 0.32);
  border-radius: 5rpx;
  pointer-events: none;
}

.nick-refresh:active {
  color: #7E382F;
  background: rgba(163, 74, 62, 0.14);
}

/* 数据统计 */
.stats-card {
  margin-top: 18rpx;
  padding: 30rpx 20rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(44rpx * var(--fs, 1));
  line-height: 1;
  color: #7D5A3B;
}

.stat-label {
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #6D645A;
}

/* 阅读设置 */
.pref-card {
  margin-top: 18rpx;
  padding: 26rpx 28rpx 24rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.pref-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pref-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.pref-note {
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #6D645A;
}

.seg {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}

.seg-item {
  flex: 1;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  border: 1rpx solid rgba(70, 58, 45, 0.12);
  background: #FBF9F6;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #5F5A52;
}

.seg-item.on {
  border-color: rgba(169, 130, 94, 0.55);
  background: rgba(169, 130, 94, 0.10);
  color: #8E5E36;
}

.pref-preview {
  display: block;
  margin-top: 18rpx;
  font-size: calc(22rpx * var(--fs, 1));
  font-family: "Songti SC", "STSong", "SimSun", serif;
  letter-spacing: 0.04em;
  line-height: 1.7;
  color: #3B3731;
}







/* 功能清单 */
.menu-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  padding: 6rpx 28rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  min-height: 44px;
  border-bottom: 1rpx solid rgba(70, 58, 45, 0.07);
}

.menu-row.last {
  border-bottom: none;
}

.menu-label {
  flex: 1;
  font-size: calc(24rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #2C2924;
}

.menu-hint {
  margin-right: 14rpx;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #6D645A;
}

.menu-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  color: #6D645A;
}

/* 收藏 / 足迹列表 */
.list-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  padding: 26rpx 28rpx 12rpx;
}

.hint-card {
  padding: 26rpx 28rpx;
}

.hint-text {
  display: block;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: calc(38rpx * var(--fs, 1));
  color: #6D645A;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.list-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.list-count {
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #6D645A;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid rgba(70, 58, 45, 0.07);
}

.row-thumb {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: block;
  border-radius: 18rpx;
  background: #F3EFE6;
  border: 3rpx solid #FFFDF8;
  box-shadow: 0 4rpx 10rpx rgba(90, 70, 50, 0.08);
  filter: saturate(0.86) brightness(1.02);
}

.row-thumb.row-thumb-modern {
  filter: saturate(0.7) brightness(1.03);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #6D645A;
}

.row-sub.sub-modern {
  color: #4A6667;
}

.row-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  color: #6D645A;
}

.row-when {
  flex: 0 0 auto;
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.02em;
  color: #6D645A;
}

/* 足迹折叠：只展示前三条，查看更多进独立页 */
.list-fold {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 4rpx 12rpx;
  border-top: 1rpx solid rgba(70, 58, 45, 0.07);
}

.fold-text {
  flex: 1;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #8E5E36;
}

.fold-count {
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #6D645A;
}

.fold-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  line-height: 1;
  color: #7D5A3B;
}

/* 信息弹层（与首页磁贴弹层同风格） */
.sheet-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
}

.sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 29, 25, 0.3);
  animation: sheetFade 0.18s ease both;
}

.info-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 62vh;
  padding: 16rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #FCFBF8;
  border-radius: 42rpx 42rpx 0 0;
  box-shadow: 0 -24rpx 52rpx rgba(90, 70, 50, 0.16);
  animation: sheetUp 0.24s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.sheet-grip {
  width: 66rpx;
  height: 6rpx;
  margin: 4rpx auto 14rpx;
  border-radius: 3rpx;
  background: #E6E0D4;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 8rpx 16rpx;
  border-bottom: 1rpx solid rgba(31, 29, 25, 0.06);
}

.sheet-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(33rpx * var(--fs, 1));
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.sheet-close {
  font-size: 40rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  color: #6D645A;
}

.info-body {
  max-height: 40vh;
  overflow-y: auto;
  padding: 10rpx 8rpx 6rpx;
}

.info-para {
  display: block;
  margin-bottom: 22rpx;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.8;
  color: #3B3731;
}

.sheet-cancel {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #EEF0F0;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #5F5A52;
  text-align: center;
  line-height: calc(84rpx * var(--fs, 1));
}

@keyframes sheetFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetUp {
  from { transform: translateY(42%); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}

/* 开发者版权署名 */
.footer {
  margin-top: 46rpx;
  margin-bottom: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.footer-rule {
  width: 56rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: rgba(70, 58, 45, 0.16);
}

.footer-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.footer-label {
  font-size: calc(19rpx * var(--fs, 1));
  letter-spacing: 0.24em;
  color: #6D645A;
  padding-left: 0.24em;
}

/* @DING 作朱砂小印式署名 */
.footer-dev {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: calc(21rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #A34A3E;
  border: 2rpx solid rgba(163, 74, 62, 0.5);
  border-radius: 6rpx;
  padding: 3rpx 12rpx 4rpx;
}

.footer-copy {
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.14em;
  color: #6D645A;
}

