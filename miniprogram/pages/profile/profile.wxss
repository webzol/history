.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 160rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(54rpx * var(--fs, 1));
  font-weight: 400;
  letter-spacing: 0.08em;
  color: #1F1D19;
}

/* 用户头卡 */
.head-card {
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F3EFE6;
  border: 4rpx solid #FFFDF8;
  box-shadow: 0 8rpx 20rpx rgba(90, 70, 50, 0.12);
}

.avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.nick {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(36rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.tagline {
  display: block;
  margin-top: 10rpx;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #8C857A;
}

.nick-refresh {
  display: inline-block;
  margin-top: 8rpx;
  font-size: calc(20rpx * var(--fs, 1));
  color: #A34A3E;
  opacity: 0.78;
  border-bottom: 1rpx solid rgba(163, 74, 62, 0.4);
  padding-bottom: 2rpx;
}

.nick-refresh:active {
  opacity: 0.5;
}

.head-seal {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  display: block;
  opacity: 0.92;
  transform: rotate(2deg);
}

/* 数据统计 */
.stats-card {
  margin-top: 18rpx;
  padding: 30rpx 20rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(44rpx * var(--fs, 1));
  line-height: 1;
  color: #A9825E;
}

.stat-label {
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #8C857A;
}

/* 阅读设置 */
.pref-card {
  margin-top: 18rpx;
  padding: 26rpx 28rpx 24rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.pref-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pref-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.pref-note {
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #A39A8E;
}

.seg {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}

.seg-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  border: 1rpx solid rgba(70, 58, 45, 0.12);
  background: #FBF9F6;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #5F5A52;
}

.seg-item.on {
  border-color: rgba(169, 130, 94, 0.55);
  background: rgba(169, 130, 94, 0.10);
  color: #8E5E36;
}

.pref-preview {
  display: block;
  margin-top: 18rpx;
  font-size: calc(22rpx * var(--fs, 1));
  font-family: "Songti SC", "STSong", "SimSun", serif;
  letter-spacing: 0.04em;
  line-height: 1.7;
  color: #3B3731;
}

/* 千古长卷：装裱画片（画心 + 底部题签） */
.plate-card {
  margin-top: 18rpx;
  padding: 14rpx 14rpx 16rpx;
  border-radius: 36rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.plate-frame {
  height: 208rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F3EFE6;
  border: 1rpx solid rgba(70, 58, 45, 0.08);
}

.plate-img {
  width: 100%;
  height: 100%;
  display: block;
  filter: saturate(0.86) contrast(1.02) brightness(1.02);
}

.plate-cap {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 10rpx 2rpx;
}

.plate-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(28rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.plate-sub {
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  line-height: 1.5;
  color: #8C857A;
  text-align: right;
}

/* 功能清单 */
.menu-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  padding: 6rpx 28rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid rgba(70, 58, 45, 0.07);
}

.menu-row.last {
  border-bottom: none;
}

.menu-label {
  flex: 1;
  font-size: calc(24rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #2C2924;
}

.menu-hint {
  margin-right: 14rpx;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #A39A8E;
}

.menu-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  color: #A39A8E;
}

/* 收藏 / 足迹列表 */
.list-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  padding: 26rpx 28rpx 12rpx;
}

.hint-card {
  padding: 26rpx 28rpx;
}

.hint-text {
  display: block;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: calc(38rpx * var(--fs, 1));
  color: #8C857A;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.list-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.list-count {
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #A39A8E;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid rgba(70, 58, 45, 0.07);
}

.row-thumb {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: block;
  border-radius: 18rpx;
  background: #F3EFE6;
  border: 3rpx solid #FFFDF8;
  box-shadow: 0 4rpx 10rpx rgba(90, 70, 50, 0.08);
  filter: saturate(0.86) brightness(1.02);
}

.row-thumb.row-thumb-modern {
  filter: saturate(0.7) brightness(1.03);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(24rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: calc(18rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #8C857A;
}

.row-sub.sub-modern {
  color: #7E9A9A;
}

.row-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  color: #A39A8E;
}

.row-when {
  flex: 0 0 auto;
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.02em;
  color: #A39A8E;
}

/* 足迹折叠：只展示前三条，查看更多进独立页 */
.list-fold {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 4rpx 12rpx;
  border-top: 1rpx solid rgba(70, 58, 45, 0.07);
}

.fold-text {
  flex: 1;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #8E5E36;
}

.fold-count {
  font-size: calc(17rpx * var(--fs, 1));
  letter-spacing: 0.03em;
  color: #A39A8E;
}

.fold-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  line-height: 1;
  color: #A9825E;
}

/* 信息弹层（与首页磁贴弹层同风格） */
.sheet-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
}

.sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 29, 25, 0.3);
  animation: sheetFade 0.18s ease both;
}

.info-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 62vh;
  padding: 16rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #FCFBF8;
  border-radius: 42rpx 42rpx 0 0;
  box-shadow: 0 -24rpx 52rpx rgba(90, 70, 50, 0.16);
  animation: sheetUp 0.24s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.sheet-grip {
  width: 66rpx;
  height: 6rpx;
  margin: 4rpx auto 14rpx;
  border-radius: 3rpx;
  background: #E6E0D4;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 8rpx 16rpx;
  border-bottom: 1rpx solid rgba(31, 29, 25, 0.06);
}

.sheet-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(33rpx * var(--fs, 1));
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.sheet-close {
  font-size: 40rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  color: #8C857A;
}

.info-body {
  max-height: 40vh;
  overflow-y: auto;
  padding: 10rpx 8rpx 6rpx;
}

.info-para {
  display: block;
  margin-bottom: 22rpx;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.8;
  color: #3B3731;
}

.sheet-cancel {
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #EEF0F0;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #5F5A52;
  text-align: center;
  line-height: calc(84rpx * var(--fs, 1));
}

@keyframes sheetFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetUp {
  from { transform: translateY(42%); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}

