.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 160rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 400;
  letter-spacing: 0.08em;
  color: #1F1D19;
}

/* 用户头卡 */
.head-card {
  margin-top: 22rpx;
  padding: 34rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid rgba(169, 130, 94, 0.35);
}

.avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.nick {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.tagline {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: #8C857A;
}

.head-seal {
  width: 46rpx;
  height: 52rpx;
  background: #A34A3E;
  color: #FFF8EF;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(2deg);
}

/* 数据统计 */
.stats-card {
  margin-top: 18rpx;
  padding: 30rpx 20rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  line-height: 1;
  color: #A9825E;
}

.stat-label {
  font-size: 20rpx;
  letter-spacing: 0.05em;
  color: #8C857A;
}

/* 千古长卷横幅 */
.banner-card {
  position: relative;
  height: 220rpx;
  margin-top: 18rpx;
  border-radius: 38rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.07);
}

.banner-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.banner-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(246, 241, 234, 0) 30%, rgba(31, 27, 22, 0.60));
}

.banner-title {
  position: absolute;
  left: 28rpx;
  bottom: 44rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.08em;
  color: #FFF8EF;
}

.banner-sub {
  position: absolute;
  left: 28rpx;
  bottom: 18rpx;
  font-size: 18rpx;
  letter-spacing: 0.04em;
  color: rgba(255, 248, 239, 0.82);
}

/* 功能清单 */
.menu-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  padding: 6rpx 28rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid rgba(70, 58, 45, 0.07);
}

.menu-row.last {
  border-bottom: none;
}

.menu-label {
  flex: 1;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: #2C2924;
}

.menu-hint {
  margin-right: 14rpx;
  font-size: 18rpx;
  letter-spacing: 0.04em;
  color: #A39A8E;
}

.menu-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  color: #A39A8E;
}

/* 收藏 / 足迹列表 */
.list-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
  padding: 26rpx 28rpx 12rpx;
}

.hint-card {
  padding: 26rpx 28rpx;
}

.hint-text {
  display: block;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #8C857A;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.list-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 27rpx;
  letter-spacing: 0.06em;
  color: #1F1D19;
}

.list-count {
  font-size: 18rpx;
  letter-spacing: 0.05em;
  color: #A39A8E;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid rgba(70, 58, 45, 0.07);
}

.row-char {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(163, 74, 62, 0.08);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  color: #A34A3E;
}

.row-char.row-modern {
  background: rgba(126, 154, 154, 0.14);
  color: #5F7E7E;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0.03em;
  color: #8C857A;
}

.row-sub.sub-modern {
  color: #7E9A9A;
}

.row-arrow {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  color: #A39A8E;
}

.row-when {
  flex: 0 0 auto;
  font-size: 17rpx;
  letter-spacing: 0.02em;
  color: #A39A8E;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  min-height: 128rpx;
  padding: 16rpx 20rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(250, 248, 243, 0.96);
  border-top: 1rpx solid rgba(70, 58, 45, 0.10);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: #7B746A;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  opacity: 0.52;
}

.tab.active {
  color: #211E1A;
}

.tab.active .tab-icon {
  opacity: 1;
}
