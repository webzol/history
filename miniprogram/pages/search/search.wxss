.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

/* 顶部：返回 + 页名 + 小印 */
.topbar {
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  line-height: 1;
  color: #1F1D19;
}

.top-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: #8C857A;
}

.top-seal {
  width: 34rpx;
  height: 58rpx;
  transform: rotate(2deg);
}

/* 搜索框卡片 */
.search-card {
  margin-top: 30rpx;
  padding: 18rpx 24rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 18rpx 42rpx rgba(90, 70, 50, 0.06);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  font-size: 34rpx;
  color: #A34A3E;
  line-height: 1;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  letter-spacing: 0.02em;
  color: #1F1D19;
}

.ph {
  color: #B9B2A6;
  letter-spacing: 0.04em;
}

.search-btn {
  padding: 10rpx 26rpx;
  border-radius: 26rpx;
  background: #A34A3E;
  color: #FFF8EF;
  font-size: 24rpx;
  letter-spacing: 0.08em;
}

/* 分组标题 */
.section-head {
  margin-top: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.12em;
  color: #1F1D19;
}

.section-count {
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: #B9B2A6;
}

/* 热门标签 */
.hot-wrap {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.hot-chip {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: inset 0 0 0 1rpx rgba(70, 58, 45, 0.08);
  font-size: 24rpx;
  letter-spacing: 0.06em;
  color: #5F5A52;
}

/* 结果列表 */
.result-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 18rpx 42rpx rgba(90, 70, 50, 0.06);
  padding: 6rpx 30rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.row + .row {
  border-top: 1rpx solid rgba(70, 58, 45, 0.08);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.05em;
  color: #1F1D19;
}

.row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  letter-spacing: 0.04em;
  color: #A9825E;
}

.row-sub.sub-modern {
  color: #7E9A9A;
}

.row-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: #C8C1B4;
}

/* 空结果 */
.empty {
  margin-top: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-line {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  letter-spacing: 0.06em;
  color: #5F5A52;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #B9B2A6;
}
