.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 120rpx;
}

/* 顶部：返回 + 页名 + 小印 */
.topbar {
  position: relative;
  margin-top: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 56rpx;
  padding: 0 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.95) 0%, rgba(249, 244, 235, 0.88) 100%);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  overflow: hidden;
  transition: transform 0.12s ease, background 0.12s ease;
}

.back-pressed {
  transform: scale(0.97);
  background: rgba(244, 236, 224, 0.96);
}

.back-icon {
  position: relative;
  width: 32rpx;
  height: 20rpx;
  flex: 0 0 32rpx;
}

.back-chevron {
  position: absolute;
  left: 1rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.back-shaft {
  position: absolute;
  left: 7rpx;
  top: 9rpx;
  width: 22rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(138, 106, 62, 0.92), rgba(138, 106, 62, 0.62));
}

.back-divider {
  width: 1rpx;
  height: 18rpx;
  margin: 0 10rpx 0 5rpx;
  background: rgba(138, 106, 62, 0.20);
  flex: 0 0 1rpx;
}

.back-label {
  font-family: "KaiTi", "STKaiti", "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  text-indent: 0.08em;
  color: #6B5A33;
  white-space: nowrap;
}

.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(26rpx * var(--fs, 1));
  letter-spacing: 0.08em;
  color: #8C857A;
}

.top-seal {
  position: absolute;
  right: 200rpx;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 34rpx;
  height: 58rpx;
  transform: rotate(2deg);
}

/* 搜索框卡片 */
.search-card {
  margin-top: 30rpx;
  padding: 18rpx 24rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 18rpx 42rpx rgba(90, 70, 50, 0.06);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  font-size: 34rpx;
  color: #A34A3E;
  line-height: 1;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: calc(28rpx * var(--fs, 1));
  letter-spacing: 0.02em;
  color: #1F1D19;
}

.ph {
  color: #B9B2A6;
  letter-spacing: 0.04em;
}

.search-btn {
  padding: 10rpx 26rpx;
  border-radius: 26rpx;
  background: #A34A3E;
  color: #FFF8EF;
  font-size: calc(24rpx * var(--fs, 1));
  letter-spacing: 0.08em;
}

/* 检索汇总（后端式返回提示） */
.search-meta {
  margin-top: 20rpx;
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #B9B2A6;
}

/* 分组标题 */
.section-head {
  margin-top: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  letter-spacing: 0.12em;
  color: #1F1D19;
}

.section-count {
  font-size: calc(20rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #B9B2A6;
}

/* 热门标签 */
.hot-wrap {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.hot-chip {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: inset 0 0 0 1rpx rgba(70, 58, 45, 0.08);
  font-size: calc(24rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #5F5A52;
}

/* 结果列表 */
.result-card {
  margin-top: 22rpx;
  border-radius: 34rpx;
  background: #FCFBF8;
  box-shadow: 0 18rpx 42rpx rgba(90, 70, 50, 0.06);
  padding: 6rpx 30rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.row + .row {
  border-top: 1rpx solid rgba(70, 58, 45, 0.08);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  letter-spacing: 0.05em;
  color: #1F1D19;
}

.row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: calc(21rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #A9825E;
}

.row-sub.sub-modern {
  color: #7E9A9A;
}

.row-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: #C8C1B4;
}

/* 空结果 */
.empty {
  margin-top: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-line {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(28rpx * var(--fs, 1));
  letter-spacing: 0.06em;
  color: #5F5A52;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: calc(22rpx * var(--fs, 1));
  letter-spacing: 0.04em;
  color: #B9B2A6;
}
