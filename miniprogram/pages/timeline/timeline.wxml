<view class="page">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="screen">

    <view class="header">
      <view class="topbar">
        <text class="brand">时间轴</text>
        <image class="brand-seal" src="/assets/seal.png" mode="aspectFit"></image>
      </view>
      <view class="intro">从史前到今天，一条可以走下去的河。</view>
    </view>

    <view class="seg">
      <text class="seg-item {{mode === 'ancient' ? 'active' : ''}}" data-mode="ancient" bindtap="switchMode">古代</text>
      <text class="seg-item {{mode === 'modern' ? 'active' : ''}}" data-mode="modern" bindtap="switchMode">近现代</text>
    </view>

    <view class="era-band">
      <view class="era-title-row">
        <text class="era-name">{{eraName}}</text>
        <image class="era-mini-seal" src="/assets/seal.png" mode="aspectFit"></image>
      </view>
      <text class="era-meta">{{eraMeta}}</text>
    </view>

    <view class="event-list">
      <view class="rail"></view>
      <view
        wx:for="{{events}}"
        wx:key="id"
        class="event-item"
        data-id="{{item.id}}"
        bindtap="onEvent"
      >
        <text class="dot {{item.dotClass}}"></text>
        <view class="event-card">
          <view class="event-head">
            <text class="event-year {{item.yearAncientText ? 'year-red' : ''}}">{{item.yearText}}</text>
            <text class="event-title">{{item.title}}</text>
          </view>
          <text class="event-desc">{{item.desc}}</text>
          <text class="event-tags">{{item.tags}}</text>
          <text class="event-source">（史料 · {{item.source}}）</text>
        </view>
      </view>
    </view>
  </view>
</view>
