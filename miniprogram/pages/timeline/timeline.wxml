<view class="page">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill"></image>
  <view class="frame"></view>
  <view class="screen">

    <view class="header">
      <image class="person-ink" src="/assets/paintings/person-ink.jpg" mode="aspectFill"></image>
      <view class="person-fade-x"></view>
      <view class="person-fade-y"></view>
      <view class="topbar">
        <text class="brand">时间轴</text>
        <view class="brand-seal">
          <text class="ss">人</text>
          <text class="ss">有</text>
          <text class="ss">志</text>
        </view>
      </view>
      <view class="intro">从史前到今天，一条可以走下去的河。</view>
    </view>

    <view class="seg">
      <text class="seg-item {{mode === 'ancient' ? 'active' : ''}}" data-mode="ancient" bindtap="switchMode">古代</text>
      <text class="seg-item {{mode === 'modern' ? 'active' : ''}}" data-mode="modern" bindtap="switchMode">近现代</text>
    </view>

    <view class="era-band">
      <view class="era-title-row">
        <text class="era-name">{{eraName}}</text>
        <view class="era-mini-seal">
          <text class="ss">大</text>
          <text class="ss">事</text>
          <text class="ss">记</text>
        </view>
      </view>
      <text class="era-meta">{{eraMeta}}</text>
      <text class="era-seal">{{eraSeal}}</text>
    </view>

    <view class="event-list">
      <view class="rail"></view>
      <view
        wx:for="{{events}}"
        wx:key="id"
        class="event-item"
        data-id="{{item.id}}"
        bindtap="onEvent"
      >
        <text class="dot {{item.dotClass}}"></text>
        <view class="event-card">
          <view class="event-head">
            <text class="event-year {{item.yearAncientText ? 'year-red' : ''}}">{{item.yearText}}</text>
            <text class="event-title">{{item.title}}</text>
          </view>
          <text class="event-desc">{{item.desc}}</text>
          <text class="event-tags">{{item.tags}}</text>
          <text class="event-source">（史料 · {{item.source}}）</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tabbar">
    <view class="tab" data-page="home" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/home.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="tab active" data-page="timeline" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/timeline.png" mode="aspectFit"></image>
      <text>时间轴</text>
    </view>
    <view class="tab" data-page="discover" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/discover.png" mode="aspectFit"></image>
      <text>发现</text>
    </view>
    <view class="tab" data-page="profile" bindtap="goTab">
      <image class="tab-icon" src="/assets/icons/profile.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
