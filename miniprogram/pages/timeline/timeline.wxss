.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

/* 参考图四周的内框细线 */
.frame {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  bottom: 24rpx;
  z-index: 1;
  border: 1rpx solid rgba(163, 74, 62, 0.22);
  border-radius: 8rpx;
  pointer-events: none;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 56rpx 160rpx;
}

/* 顶部：品牌行 + 水墨人物 */
.header {
  position: relative;
  margin-top: 76rpx;
}

.person-ink {
  position: absolute;
  right: -26rpx;
  top: -30rpx;
  width: 330rpx;
  height: 400rpx;
  display: block;
  z-index: 0;
}

/* 让人物图向左、向下融入宣纸 */
.person-fade-x {
  position: absolute;
  right: -26rpx;
  top: -30rpx;
  width: 330rpx;
  height: 400rpx;
  z-index: 1;
  background: linear-gradient(90deg, #F6F1EA 0%, rgba(246, 241, 234, 0.55) 22%, rgba(246, 241, 234, 0) 52%);
  pointer-events: none;
}

.person-fade-y {
  position: absolute;
  right: -26rpx;
  top: -30rpx;
  width: 330rpx;
  height: 400rpx;
  z-index: 1;
  background: linear-gradient(180deg, rgba(246, 241, 234, 0.2), rgba(246, 241, 234, 0) 32%, rgba(246, 241, 234, 0.35) 62%, #F6F1EA 94%);
  pointer-events: none;
}

.topbar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 60rpx;
  font-weight: 400;
  letter-spacing: 0.10em;
  line-height: 1.15;
  color: #1F1D19;
}

/* 标题旁的小朱砂印（竖排"人有志"） */
.brand-seal {
  width: 34rpx;
  margin-top: 8rpx;
  padding: 10rpx 0;
  background: #A34A3E;
  border-radius: 8rpx;
  font-size: 15rpx;
  line-height: 1.5;
  letter-spacing: 0;
  color: #FFF8EF;
  text-align: center;
  transform: rotate(2deg);
}

.intro {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.6;
  letter-spacing: 0.02em;
  color: #5F5A52;
}

/* 古代 / 近现代 分段 */
.seg {
  position: relative;
  z-index: 2;
  display: flex;
  margin-top: 34rpx;
  padding: 8rpx;
  border-radius: 44rpx;
  background: rgba(252, 251, 248, 0.34);
  box-shadow: inset 0 0 0 1rpx rgba(70, 58, 45, 0.06);
}

.seg-item {
  flex: 1;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  letter-spacing: 0.10em;
  color: #1F1D19;
}

.seg-item.active {
  background: #FCFBF8;
  color: #A34A3E;
  box-shadow: 0 10rpx 24rpx rgba(90, 70, 50, 0.10), inset 0 0 0 1rpx rgba(163, 74, 62, 0.16);
}

/* 朝代头卡 */
.era-band {
  position: relative;
  margin-top: 30rpx;
  padding: 30rpx 34rpx;
  border-radius: 36rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.era-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.era-name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 52rpx;
  letter-spacing: 0.10em;
  line-height: 1.15;
  color: #1F1D19;
}

/* 北宋旁的小立印（竖排"大事记"） */
.era-mini-seal {
  width: 26rpx;
  margin-top: 6rpx;
  padding: 8rpx 0;
  background: #A34A3E;
  border-radius: 7rpx;
  font-size: 13rpx;
  line-height: 1.5;
  color: #FFF8EF;
  text-align: center;
  transform: rotate(2deg);
}

.era-meta {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #8C857A;
}

.era-seal {
  position: absolute;
  right: 30rpx;
  top: 26rpx;
  width: 92rpx;
  height: 92rpx;
  background: #A34A3E;
  border-radius: 16rpx;
  color: #FFF8EF;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-2deg);
  box-shadow: 0 10rpx 24rpx rgba(163, 74, 62, 0.25);
}

/* 沿竖线挂卡的事件列表 */
.event-list {
  position: relative;
  margin-top: 32rpx;
  padding-left: 56rpx;
}

.rail {
  position: absolute;
  left: 19rpx;
  top: 16rpx;
  bottom: 26rpx;
  width: 2rpx;
  background: rgba(31, 27, 22, 0.26);
}

.event-item {
  position: relative;
  margin-bottom: 30rpx;
}

.dot {
  position: absolute;
  left: -45rpx;
  top: 40rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  z-index: 2;
}

.dot-red {
  background: #A34A3E;
}

.dot-teal {
  background: #7E9A9A;
}

.event-card {
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 18rpx 40rpx rgba(90, 70, 50, 0.06);
}

.event-head {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  flex-wrap: wrap;
}

.event-year {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 0.05em;
  color: #1F1D19;
}

.event-year.year-red {
  font-size: 24rpx;
  color: #A34A3E;
}

.event-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.event-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #5F5A52;
}

.event-tags {
  display: block;
  margin-top: 12rpx;
  font-size: 17rpx;
  letter-spacing: 0.05em;
  color: #8C857A;
}

.event-source {
  display: block;
  margin-top: 8rpx;
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 17rpx;
  letter-spacing: 0.02em;
  color: #A39A8E;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  min-height: 128rpx;
  padding: 16rpx 20rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(250, 248, 243, 0.96);
  border-top: 1rpx solid rgba(70, 58, 45, 0.10);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: #7B746A;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  opacity: 0.52;
}

.tab.active {
  color: #211E1A;
}

.tab.active .tab-icon {
  opacity: 1;
}
