.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.screen {
  position: relative;
  z-index: 2;
  padding: 0 46rpx 160rpx;
}

.topbar {
  margin-top: 88rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 400;
  letter-spacing: 0.08em;
  line-height: 1;
  color: #1F1D19;
}

.intro {
  margin-top: 30rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.6;
  letter-spacing: 0.02em;
  color: #5F5A52;
}

.seg {
  display: flex;
  margin-top: 28rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(70, 58, 45, 0.10);
  border-radius: 34rpx;
  background: rgba(255, 253, 250, 0.58);
}

.seg-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: #8C857A;
}

.seg-item.active {
  background: #FCFBF8;
  color: #A9825E;
  font-weight: 500;
  box-shadow: 0 8rpx 18rpx rgba(90, 70, 50, 0.08);
}

.era-band {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.era-name {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 42rpx;
  letter-spacing: 0.08em;
  color: #1F1D19;
}

.era-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 19rpx;
  letter-spacing: 0.03em;
  color: #8C857A;
}

.era-seal {
  width: 52rpx;
  height: 58rpx;
  background: #A34A3E;
  color: #FFF8EF;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(2deg);
}

.event-list {
  margin-top: 22rpx;
}

.event-card {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  border-left: 4rpx solid transparent;
  box-shadow: 0 16rpx 34rpx rgba(90, 70, 50, 0.045);
}

.event-card.active {
  border-left-color: #A9825E;
  box-shadow: 0 20rpx 42rpx rgba(90, 70, 50, 0.07);
}

.event-year {
  width: 120rpx;
  flex: 0 0 120rpx;
  padding-top: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 22rpx;
  line-height: 1.45;
  color: #A9825E;
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  letter-spacing: 0.04em;
  color: #1F1D19;
}

.event-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #5F5A52;
}

.event-tags {
  display: block;
  margin-top: 12rpx;
  font-size: 16rpx;
  letter-spacing: 0.05em;
  color: #8C857A;
}

.event-source {
  display: block;
  margin-top: 10rpx;
  font-size: 15rpx;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: #A39A8E;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  min-height: 128rpx;
  padding: 16rpx 20rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(250, 248, 243, 0.96);
  border-top: 1rpx solid rgba(70, 58, 45, 0.10);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: #7B746A;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  opacity: 0.52;
}

.tab.active {
  color: #211E1A;
}

.tab.active .tab-icon {
  opacity: 1;
}
