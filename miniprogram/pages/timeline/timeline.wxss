.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

/* 参考图四周的内框细线 */
.screen {
  position: relative;
  z-index: 2;
  padding: 0 56rpx 160rpx;
}

/* 顶部：品牌行 */
.header {
  position: relative;
  margin-top: 76rpx;
}

.topbar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.brand {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 60rpx;
  font-weight: 400;
  letter-spacing: 0.10em;
  line-height: 1.15;
  color: #1F1D19;
}

/* 标题旁的小朱砂印：首页同款"史载"印章图（assets/seal.png，自 palace 裁切） */
.brand-seal {
  margin-top: 10rpx;
  width: 38rpx;
  height: 64rpx;
  transform: rotate(2deg);
}

.intro {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.6;
  letter-spacing: 0.02em;
  color: #5F5A52;
}

/* 古代 / 近现代 分段 */
.seg {
  position: relative;
  z-index: 2;
  display: flex;
  margin-top: 30rpx;
  padding: 8rpx;
  border-radius: 44rpx;
  background: rgba(252, 251, 248, 0.94);
  box-shadow: inset 0 0 0 1rpx rgba(70, 58, 45, 0.06);
}

.seg-item {
  flex: 1;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  letter-spacing: 0.10em;
  color: #1F1D19;
}

.seg-item.active {
  background: #FCFBF8;
  color: #A34A3E;
  box-shadow: 0 10rpx 24rpx rgba(90, 70, 50, 0.10), inset 0 0 0 1rpx rgba(163, 74, 62, 0.16);
}

/* 朝代头卡 */
.era-band {
  position: relative;
  z-index: 2;
  margin-top: 30rpx;
  padding: 30rpx 34rpx;
  border-radius: 36rpx;
  background: #FCFBF8;
  box-shadow: 0 20rpx 46rpx rgba(90, 70, 50, 0.06);
}

.era-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.era-name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 52rpx;
  letter-spacing: 0.10em;
  line-height: 1.15;
  color: #1F1D19;
}

/* 北宋旁的小立印：同款印章图 */
.era-mini-seal {
  margin-top: 8rpx;
  width: 34rpx;
  height: 58rpx;
  transform: rotate(2deg);
}

.era-meta {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #8C857A;
}

/* 沿竖线挂卡的事件列表 */
.event-list {
  position: relative;
  z-index: 2;
  margin-top: 32rpx;
  padding-left: 56rpx;
}

.rail {
  position: absolute;
  left: 19rpx;
  top: 16rpx;
  bottom: 26rpx;
  width: 2rpx;
  background: rgba(31, 27, 22, 0.26);
}

.event-item {
  position: relative;
  margin-bottom: 30rpx;
}

.dot {
  position: absolute;
  left: -45rpx;
  top: 40rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  z-index: 2;
}

.dot-red {
  background: #A34A3E;
}

.dot-teal {
  background: #7E9A9A;
}

.event-card {
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background: #FCFBF8;
  box-shadow: 0 18rpx 40rpx rgba(90, 70, 50, 0.06);
}

.event-head {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  flex-wrap: wrap;
}

.event-year {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 0.05em;
  color: #1F1D19;
}

.event-year.year-red {
  font-size: 24rpx;
  color: #A34A3E;
}

.event-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 0.07em;
  color: #1F1D19;
}

.event-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #5F5A52;
}

.event-tags {
  display: block;
  margin-top: 12rpx;
  font-size: 17rpx;
  letter-spacing: 0.05em;
  color: #8C857A;
}

.event-source {
  display: block;
  margin-top: 8rpx;
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 17rpx;
  letter-spacing: 0.02em;
  color: #A39A8E;
}

