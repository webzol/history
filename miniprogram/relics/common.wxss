.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg { position: fixed; inset: 0; width: 100%; height: 100%; }
.screen { position: relative; padding: 0 46rpx calc(56rpx + env(safe-area-inset-bottom)); }
.topbar { position: relative; display: flex; align-items: center; height: 88rpx; margin-top: 82rpx; }
.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(36rpx * var(--fs, 1));
  line-height: 1.4;
  color: #1F1D19;
}
.top-seal { position: absolute; right: 200rpx; width: 30rpx; height: 36rpx; }

.back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 56rpx;
  border: 1rpx solid rgba(166, 128, 76, 0.38);
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFDF9, #F9F4EB);
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 50, 0.06);
}
.back-hit-pressed .back { background: #F1E8DD; }
.back-icon { position: relative; width: 32rpx; height: 20rpx; }
.back-chevron {
  position: absolute;
  left: 1rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8A6A3E;
  border-bottom: 2rpx solid #8A6A3E;
  transform: rotate(45deg);
}
.back-shaft { position: absolute; left: 7rpx; top: 9rpx; width: 22rpx; height: 2rpx; background: #8A6A3E; }
.back-divider { width: 1rpx; height: 18rpx; margin: 0 10rpx 0 5rpx; background: rgba(138, 106, 62, 0.20); }
.back-label { color: #6B5A33; font-family: "KaiTi", "STKaiti", serif; font-size: calc(24rpx * var(--fs, 1)); }

.relic-cover { position: relative; overflow: hidden; }
.cover-fade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 29rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(252, 251, 248, 0), rgba(252, 251, 248, 0.3) 58%, #FCFBF8);
}

.relic-empty {
  padding: 34rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  color: #5F5A52;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.6;
  text-align: center;
}
.relic-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #F1E8DD;
  color: #6B5036;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.45;
}
