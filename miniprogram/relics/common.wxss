.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F1EA;
}

.paper-bg { position: fixed; inset: 0; width: 100%; height: 100%; }
.screen { position: relative; padding: 0 46rpx calc(56rpx + env(safe-area-inset-bottom)); }
.topbar { position: relative; display: flex; align-items: center; height: 88rpx; margin-top: 82rpx; }
.top-title {
  position: absolute;
  left: 54%;
  transform: translateX(-50%);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(36rpx * var(--fs, 1));
  line-height: 1.4;
  color: #1F1D19;
}
.top-seal { position: absolute; right: 200rpx; width: 30rpx; height: 36rpx; }

.relic-cover { position: relative; overflow: hidden; }
.cover-fade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 29rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(252, 251, 248, 0), rgba(252, 251, 248, 0.3) 58%, #FCFBF8);
}

.relic-empty {
  padding: 34rpx;
  border-radius: 38rpx;
  background: #FCFBF8;
  color: #5F5A52;
  font-size: calc(26rpx * var(--fs, 1));
  line-height: 1.6;
  text-align: center;
}
.relic-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.relic-loading-inline {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.relic-spinner {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 3rpx solid #E8E1D7;
  border-top-color: #A34A3E;
  border-radius: 50%;
  animation: relic-spin 0.85s linear infinite;
}

.relic-loading-inline .relic-spinner {
  width: 22rpx;
  height: 22rpx;
  border-width: 2rpx;
}

@keyframes relic-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .relic-spinner { animation: none; } }

.relic-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #F1E8DD;
  color: #6B5036;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.45;
}
