<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="screen" aria-hidden="{{share.open}}">
    <view class="topbar">
      <view class="back-hit" bindtap="goBack" hover-class="back-hit-pressed" hover-stay-time="80" aria-role="button" aria-label="返回文物列表">
        <view class="back" aria-hidden="true">
          <view class="back-icon"><view class="back-chevron"></view><view class="back-shaft"></view></view>
          <view class="back-divider"></view><text class="back-label">返回</text>
        </view>
      </view>
      <text class="top-title">文物</text>
      <image class="top-seal" src="/assets/seal.png" mode="aspectFit" aria-hidden="true"></image>
    </view>

    <block wx:if="{{relic}}">
      <view class="object-card">
        <text class="object-type">{{relic.period}} · {{relic.type}}</text>
        <text class="object-name" aria-role="heading">{{relic.title}}</text>
        <text class="object-date">{{relic.date}}</text>
        <view wx:if="{{!degraded}}" class="relic-cover object-cover" style="padding-top: {{relic.imageRatio}}%;">
          <image class="object-image" src="{{relic.image}}" mode="aspectFit" binderror="onImageError"
            aria-label="{{relic.title + (relic.imageNote ? '，' + relic.imageNote : '，馆藏图像')}}"></image>
          <view class="cover-fade" aria-hidden="true"></view>
        </view>
        <view wx:else class="relic-cover object-cover" style="padding-top: 72%;">
          <image class="object-image" src="{{relic.imageThumb}}" mode="aspectFit" aria-hidden="true"></image>
          <view class="cover-fade" aria-hidden="true"></view>
        </view>
        <text class="object-image-note">{{degraded ? '详情大图离线暂不可用，显示缩略图 · ' : ''}}{{relic.imageNote ? relic.imageNote + ' · ' : ''}}{{relic.museum}} · {{relic.rights}}</text>
      </view>

      <view class="details-card">
        <view class="details-heading">
          <text class="details-title" aria-role="heading">文物简介</text>
          <view class="details-rule" aria-hidden="true"></view>
        </view>
        <text class="object-description">{{relic.description}}</text>
        <view class="facts">
          <view class="fact"><text class="fact-label">材质</text><text>{{relic.material}}</text></view>
          <view class="fact"><text class="fact-label">尺寸</text><text>{{relic.dimensions}}</text></view>
          <view class="fact"><text class="fact-label">馆藏</text><text>{{relic.museum}}</text></view>
          <view class="fact"><text class="fact-label">藏品编号</text><text>{{relic.accession}}</text></view>
        </view>
        <view class="source-toggle" bindtap="toggleSource" aria-role="button"
          aria-label="{{sourceOpen ? '收起馆方藏品页地址' : '展开馆方藏品页地址'}}">
          <text>馆方藏品页</text><text aria-hidden="true">{{sourceOpen ? '⌃' : '›'}}</text>
        </view>
        <text wx:if="{{sourceOpen}}" class="source-url" user-select="{{true}}">{{relic.url}}</text>
      </view>
      <view class="relic-action object-share" bindtap="openShare" hover-class="object-share-pressed" hover-stay-time="80"
        aria-role="button" aria-label="打开文物分享卡片">共此卷</view>
    </block>
    <view wx:else class="relic-empty">
      <text>未找到这件文物。</text>
      <view class="relic-action" bindtap="goBack" aria-role="button">返回文物列表</view>
    </view>
  </view>

  <view wx:if="{{share.open}}" class="ss-layer relic-share-layer">
    <view class="ss-mask" bindtap="closeShare" catchtouchmove="noop" aria-hidden="true"></view>
    <view class="ss-panel relic-share-sheet" aria-role="dialog" aria-modal="true" aria-label="共此卷，文物分享卡片">
      <view class="ss-grip" aria-hidden="true"></view>
      <view class="ss-head">
        <text class="ss-title" aria-role="heading">共此卷</text>
        <view class="ss-close ss-close-touch" bindtap="closeShare" aria-role="button" aria-label="关闭分享卡片">×</view>
      </view>
      <view class="ss-qr-wrap" aria-role="img" aria-label="{{share.title + (share.fallback ? '，备用分享卡片' : '，文物分享卡片预览')}}">
        <image wx:if="{{share.fallback}}" aria-hidden="true" class="ss-canvas" src="/assets/share-fallback.jpg" mode="aspectFit"></image>
        <canvas wx:else aria-hidden="true" type="2d" id="ssQrCanvas" class="ss-canvas" disable-scroll="true"></canvas>
      </view>
      <view class="relic-share-actions">
        <button class="share-action send-action" open-type="share" hover-class="share-action-pressed" hover-stay-time="80">
          <view class="share-action-icon send-icon" aria-hidden="true"></view>
          <text>转寄好友</text>
        </button>
        <view class="share-action save-action {{share.coverPending && !share.fallback ? 'share-pending' : ''}}" bindtap="saveQr"
          hover-class="{{share.coverPending && !share.fallback ? 'none' : 'share-action-pressed'}}" hover-stay-time="80"
          aria-role="button" aria-disabled="{{share.coverPending && !share.fallback}}">
          <view class="share-action-icon save-icon" aria-hidden="true"></view>
          <text>{{share.coverPending && !share.fallback ? '生成中' : '保存卡片'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
<feedback-popup></feedback-popup>
<privacy-popup></privacy-popup>
