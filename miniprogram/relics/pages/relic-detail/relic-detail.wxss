@import "../../common.wxss";

.object-card, .details-card { padding: 28rpx; border-radius: 38rpx; background: #FCFBF8; }
.object-card { margin-top: 20rpx; }
.object-type { display: block; color: #865C3B; font-size: calc(22rpx * var(--fs, 1)); line-height: 1.5; }
.object-name {
  display: block;
  margin-top: 5rpx;
  color: #1F1D19;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(43rpx * var(--fs, 1));
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.object-date { display: block; margin-top: 9rpx; color: #5F5A52; font-size: calc(24rpx * var(--fs, 1)); line-height: 1.55; }
.object-cover { margin-top: 24rpx; border-radius: 16rpx 16rpx 0 0; background: #F3EFE6; }
.object-cover .cover-fade { height: 35rpx; }
.object-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.object-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 130rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #F3EFE6;
  color: #5F5A52;
  font-size: calc(24rpx * var(--fs, 1));
}
.object-image-note { display: block; margin-top: 10rpx; color: #5F5A52; text-align: right; font-size: calc(19rpx * var(--fs, 1)); }
.details-card { margin-top: 22rpx; }
.details-heading { display: flex; align-items: center; gap: 16rpx; }
.details-title {
  color: #864B40;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(30rpx * var(--fs, 1));
  line-height: 1.4;
}
.details-rule { flex: 1; height: 1rpx; background: linear-gradient(90deg, #D9BDB0, transparent); }
.object-description {
  display: block;
  margin: 12rpx 0 22rpx;
  color: #3B3731;
  font-size: calc(27rpx * var(--fs, 1));
  line-height: 1.8;
}
.facts {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.fact {
  width: calc((100% - 14rpx) / 2);
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  background: #F7F3ED;
  color: #3B3731;
  font-size: calc(24rpx * var(--fs, 1));
  line-height: 1.55;
}
.fact-label { display: block; color: #5F5A52; font-size: calc(20rpx * var(--fs, 1)); }
.source-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  margin-top: 8rpx;
  color: #7D5A3B;
  font-size: calc(22rpx * var(--fs, 1));
}
.source-url { display: block; margin-top: 10rpx; color: #865C3B; font-size: calc(21rpx * var(--fs, 1)); line-height: 1.55; word-break: break-all; }
.object-data-note {
  margin-top: 16rpx;
  padding: 16rpx 22rpx;
  border-left: 3rpx solid rgba(163, 74, 62, 0.54);
  border-radius: 18rpx;
  background: #F1E8DD;
  color: #5F5A52;
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.6;
}
.object-share {
  position: relative;
  gap: 20rpx;
  min-height: 50px;
  margin-top: 22rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid #C5A384;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #FCFBF8, #F1E8DD);
  box-shadow: 0 5rpx 16rpx rgba(90, 70, 50, 0.06);
  color: #63472F;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(29rpx * var(--fs, 1));
  font-weight: 600;
  letter-spacing: 0.12em;
}
.object-share::before {
  position: absolute;
  inset: 6rpx;
  border: 1rpx solid rgba(158, 114, 76, 0.26);
  border-radius: 24rpx;
  pointer-events: none;
  content: '';
}
.object-share-ornament {
  display: flex;
  flex: 0 0 60rpx;
  align-items: center;
  gap: 7rpx;
  color: #AA7856;
  pointer-events: none;
}
.object-share-ornament-end { transform: scaleX(-1); }
.object-share-ornament::before {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, currentColor);
  content: '';
}
.object-share-fret {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  border: 1rpx solid currentColor;
  border-left: 0;
}
.object-share-fret::after {
  position: absolute;
  inset: 3rpx;
  border: 1rpx solid currentColor;
  border-right: 0;
  content: '';
}
.object-share-pressed { background: #EBDFD1; }

.relic-share-sheet .ss-qr-wrap { margin: 12rpx 0 26rpx; }
.relic-share-sheet .ss-canvas { box-shadow: 0 14rpx 34rpx rgba(90, 70, 50, 0.09); }
@media (max-height: 660px) {
  .relic-share-sheet .ss-canvas { width: 196px; height: 319.63px; }
}
@media (max-height: 530px) {
  .relic-share-sheet .ss-canvas { width: 172px; height: 280.49px; }
}

@media (max-height: 460px) {
  .relic-share-sheet .ss-canvas { width: 148px; height: 241.35px; }
}
@media (prefers-reduced-motion: reduce) {
  .relic-share-layer .ss-panel, .relic-share-layer .ss-mask { animation: none; }
}
