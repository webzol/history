<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="screen" aria-hidden="{{!!filterSheet}}">
    <view class="topbar">
      <view class="back-hit" bindtap="goBack" hover-class="back-hit-pressed" hover-stay-time="80" aria-role="button" aria-label="返回上一页">
        <view class="back" aria-hidden="true">
          <view class="back-icon"><view class="back-chevron"></view><view class="back-shaft"></view></view>
          <view class="back-divider"></view><text class="back-label">返回</text>
        </view>
      </view>
      <text class="top-title" aria-role="heading">文物</text>
      <image class="top-seal" src="/assets/seal.png" mode="aspectFit" aria-hidden="true"></image>
    </view>

    <view class="filter-card">
      <view class="filter-trigger" data-kind="type" bindtap="openFilter" aria-role="button" aria-label="{{'选择器类，当前' + types[typeIndex]}}">
        <text class="filter-label">器类</text><text class="filter-value">{{types[typeIndex]}}</text>
        <view class="filter-chevron" aria-hidden="true"></view>
      </view>
      <view class="filter-trigger" data-kind="era" bindtap="openFilter" aria-role="button" aria-label="{{'选择时代，当前' + eras[eraIndex]}}">
        <text class="filter-label">时代</text><text class="filter-value">{{eras[eraIndex]}}</text>
        <view class="filter-chevron" aria-hidden="true"></view>
      </view>
    </view>

    <view class="gallery-head">
      <text class="gallery-title" aria-role="heading">馆藏</text>
      <text class="result-count" aria-live="polite">{{indexLoading ? '目录加载中' : (indexFailed ? '目录加载失败' : count + ' 件')}}</text>
    </view>
    <view wx:if="{{indexLoading}}" class="relic-empty">
      <text>馆藏目录加载中，请稍候。</text>
    </view>
    <view wx:elif="{{indexFailed}}" class="relic-empty">
      <text>目录加载失败，请检查网络后重试。</text>
      <view class="relic-action" bindtap="retryIndex" aria-role="button">重新加载</view>
    </view>
    <view wx:elif="{{count}}" class="relic-grid">
      <view wx:for="{{rows}}" wx:key="id" class="relic-card" data-id="{{item.id}}" bindtap="openRelic"
        hover-class="relic-card-pressed" hover-stay-time="80" aria-role="button" aria-label="{{item.title + '，' + item.period + '，' + item.type}}">
        <view class="relic-cover">
          <image class="relic-thumb" src="{{item.thumb}}" mode="aspectFit" lazy-load binderror="onThumbError" data-index="{{index}}" aria-hidden="true"></image>
          <view class="cover-fade" aria-hidden="true"></view>
        </view>
        <view class="relic-card-copy">
          <text class="relic-name">{{item.title}}</text>
          <view class="relic-meta"><text>{{item.period}}</text><text class="relic-meta-type"> · {{item.type}}</text></view>
        </view>
      </view>
    </view>
    <view wx:else class="relic-empty">
      <text>这个时代与器类下暂无藏品。</text>
      <view class="relic-action" bindtap="resetFilters" aria-role="button">清除筛选</view>
    </view>
    <view wx:if="{{hasMore}}" class="relic-action more-relics" bindtap="loadMore" aria-role="button">加载更多</view>
  </view>

  <view class="filter-layer" wx:if="{{filterSheet}}">
    <view class="filter-mask" bindtap="closeFilter" catchtouchmove="noop" aria-hidden="true"></view>
    <view class="filter-sheet" aria-role="dialog" aria-modal="true" aria-label="{{filterSheet.title}}">
      <view class="filter-grip" aria-hidden="true"></view>
      <view class="filter-head">
        <text class="filter-title" aria-role="heading">{{filterSheet.title}}</text>
        <view class="filter-close" bindtap="closeFilter" aria-role="button" aria-label="关闭筛选面板">×</view>
      </view>
      <scroll-view class="filter-list" scroll-y="{{true}}" style="height: {{filterSheet.options.length * 44}}px;">
        <view class="filter-option {{filterSheet.selected === index ? 'selected' : ''}}" wx:for="{{filterSheet.options}}" wx:key="*this"
          data-index="{{index}}" bindtap="onFilterPick" hover-class="filter-pressed" hover-stay-time="80"
          aria-role="button" aria-label="{{item + (filterSheet.selected === index ? '，已选中' : '')}}">
          <text>{{item}}</text><text wx:if="{{filterSheet.selected === index}}" class="filter-check" aria-hidden="true">✓</text>
        </view>
      </scroll-view>
      <view class="filter-cancel" bindtap="closeFilter" aria-role="button">取消</view>
    </view>
  </view>
</view>
<feedback-popup></feedback-popup>
<privacy-popup></privacy-popup>
