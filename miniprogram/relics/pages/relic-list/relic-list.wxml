<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="screen" aria-hidden="{{!!filterSheet}}">
    <view class="topbar nav-with-back">
      <view class="back-hit" bindtap="goBack" hover-class="back-hit-pressed" hover-stay-time="80"
        aria-role="button" aria-label="{{mode === 'cate' ? '返回上一页' : '返回全部分类'}}">
        <view class="back" aria-hidden="true">
          <view class="back-icon"><view class="back-chevron"></view><view class="back-shaft"></view></view>
          <view class="back-divider"></view><text class="back-label">{{mode === 'cate' ? '返回' : '全部分类'}}</text>
        </view>
      </view>
      <text wx:if="{{mode !== 'cate'}}" class="top-title" aria-role="heading">文物</text>
      <image wx:if="{{mode !== 'cate'}}" class="top-seal" src="/assets/seal.png" mode="aspectFit" aria-hidden="true"></image>
    </view>

    <!-- 分类首屏：器类 / 时代 -->
    <block wx:if="{{mode === 'cate'}}">
      <view class="catalog-head">
        <image class="catalog-landscape" src="/relics/assets/catalog-landscape.jpg" mode="aspectFill" aria-hidden="true"></image>
        <view class="catalog-copy">
          <text class="catalog-title" aria-role="heading">博物馆藏品</text>
          <view class="catalog-rule" aria-hidden="true"></view>
          <text class="catalog-subtitle">数字博物馆</text>
          <view wx:if="{{!indexLoading && !indexFailed}}" class="result-count" aria-live="polite">
            <view wx:if="{{partial && !stalled}}" class="relic-loading-inline">
              <view class="relic-spinner" aria-hidden="true"></view>
              <text>已载入 {{loadedText}} / {{totalText}} 件</text>
            </view>
            <text wx:else>{{totalText}} 件</text>
          </view>
        </view>
      </view>
      <view class="cate-heading">
        <text class="cate-heading-title" aria-role="heading">{{cateTab === 'type' ? '器类' : '时代'}}</text>
        <view class="cate-switch" data-tab="{{cateTab === 'type' ? 'era' : 'type'}}" bindtap="switchCateTab"
          hover-class="cate-tab-pressed" hover-stay-time="80" aria-role="button">
          <view class="cate-switch-icon" aria-hidden="true"><view></view><view></view></view>
          <text>{{cateTab === 'type' ? '按时代' : '按器类'}}</text>
        </view>
      </view>
      <view wx:if="{{indexLoading}}" class="relic-empty relic-loading" aria-live="polite">
        <view class="relic-spinner" aria-hidden="true"></view>
        <text>正在加载馆藏目录</text>
      </view>
      <view wx:elif="{{indexFailed}}" class="relic-empty">
        <text>目录加载失败，请检查网络后重试。</text>
        <view class="relic-action" bindtap="retryIndex" aria-role="button">重新加载</view>
      </view>
      <view wx:else class="cate-grid">
        <view wx:for="{{cateCards}}" wx:key="key" class="cate-card {{cateTab === 'type' && index < 2 ? 'cate-card-feature' : ''}} {{cateTab === 'era' && index === 0 ? 'cate-era-feature' : ''}}"
          data-kind="{{cateTab}}" data-index="{{index}}"
          bindtap="openCategory" hover-class="relic-card-pressed" hover-stay-time="80" aria-role="button"
          aria-label="{{item.name}}">
          <view class="cate-cover {{item.art ? 'cate-cover-art' : ''}}">
            <image wx:if="{{item.art || item.thumb}}" class="cate-thumb" src="{{item.art || item.thumb}}" mode="aspectFit" lazy-load
              binderror="onCateThumbError" data-index="{{index}}" data-key="{{item.key}}" data-src="{{item.art || item.thumb}}" aria-hidden="true"></image>
          </view>
          <view class="cate-copy">
            <text class="cate-name">{{item.name}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!indexLoading && !indexFailed && stalled}}" class="relic-action more-relics" bindtap="retryIndex" aria-role="button">分块补齐受阻 · 点按重试</view>
    </block>

    <!-- 分类内文物网格 -->
    <block wx:else>
      <view class="gallery-head">
        <view class="gallery-copy">
          <text class="gallery-title" aria-role="heading">{{gridLabel}}</text>
          <text wx:if="{{!indexLoading && !indexFailed}}" class="result-count" aria-live="polite">{{count}} 件</text>
        </view>
        <view class="filter-trigger" bindtap="openFilter" hover-class="filter-pressed" hover-stay-time="80" aria-role="button"
          aria-label="{{'寻物，器类 ' + types[typeIndex] + '，时代 ' + eras[eraIndex]}}">
          <view class="filter-icon" aria-hidden="true"><view></view><view></view></view>
          <text>寻物</text>
        </view>
      </view>
      <view wx:if="{{indexLoading}}" class="relic-empty relic-loading" aria-live="polite">
        <view class="relic-spinner" aria-hidden="true"></view>
        <text>正在加载馆藏目录</text>
      </view>
      <view wx:elif="{{indexFailed}}" class="relic-empty">
        <text>目录加载失败，请检查网络后重试。</text>
        <view class="relic-action" bindtap="retryIndex" aria-role="button">重新加载</view>
      </view>
      <view wx:elif="{{!count}}" class="relic-empty">
        <text>这个时代与器类下暂无藏品。</text>
        <view class="relic-action" bindtap="resetFilters" aria-role="button">返回分类</view>
      </view>
      <view wx:elif="{{rows.length}}" class="relic-grid">
        <view wx:for="{{rows}}" wx:key="id" class="relic-card" data-id="{{item.id}}" bindtap="openRelic"
          hover-class="relic-card-pressed" hover-stay-time="80" aria-role="button" aria-label="{{item.title + '，' + item.period + '，' + item.type}}">
          <view class="relic-cover">
            <image class="relic-thumb" src="{{item.thumb}}" mode="aspectFit" lazy-load binderror="onThumbError" data-index="{{index}}" aria-hidden="true"></image>
            <view class="cover-fade" aria-hidden="true"></view>
          </view>
          <view class="relic-card-copy">
            <view class="relic-name">{{item.title}}</view>
            <view class="relic-meta"><text>{{item.period}}</text><text class="relic-meta-type"> · {{item.type}}</text></view>
          </view>
        </view>
      </view>
      <view wx:elif="{{partial}}" class="relic-empty relic-loading" aria-live="polite">
        <view wx:if="{{!stalled}}" class="relic-spinner" aria-hidden="true"></view>
        <text>{{stalled ? '该分类的藏品暂未加载完成。' : '正在加载该分类的藏品'}}</text>
      </view>
      <view wx:else class="relic-empty">
        <text>这个时代与器类下暂无藏品。</text>
        <view class="relic-action" bindtap="resetFilters" aria-role="button">返回分类</view>
      </view>
      <view wx:if="{{stalled}}" class="relic-action more-relics" bindtap="retryIndex" aria-role="button">分块补齐受阻 · 点按重试</view>
      <view wx:elif="{{!indexLoading && !indexFailed && partial && rows.length}}" class="relic-note" aria-live="polite">
        <view class="relic-loading-inline">
          <view class="relic-spinner" aria-hidden="true"></view>
          <text>已载入 {{loadedText}} / {{totalText}} 件</text>
        </view>
      </view>
      <view wx:if="{{hasMore}}" class="relic-action more-relics" bindtap="loadMore" aria-role="button">加载更多</view>
    </block>
  </view>

  <view class="filter-layer" wx:if="{{filterSheet}}">
    <view class="filter-mask" bindtap="closeFilter" catchtouchmove="noop" aria-hidden="true"></view>
    <view class="filter-sheet" aria-role="dialog" aria-modal="true" aria-label="寻物">
      <view class="filter-grip" aria-hidden="true"></view>
      <view class="filter-head">
        <text class="filter-title" aria-role="heading">寻物</text>
        <view class="filter-close" bindtap="closeFilter" aria-role="button" aria-label="关闭寻物面板">×</view>
      </view>
      <scroll-view class="filter-list" scroll-y="{{true}}">
        <view class="filter-group">
          <text class="filter-group-title" aria-role="heading">器类</text>
          <view class="filter-options">
            <view class="filter-option {{filterSheet.typeIndex === index ? 'selected' : ''}}" wx:for="{{types}}" wx:key="*this"
              data-kind="type" data-index="{{index}}" bindtap="onFilterPick" hover-class="filter-pressed" hover-stay-time="80"
              aria-role="button" aria-label="{{item + (filterSheet.typeIndex === index ? '，已选中' : '')}}">{{item}}</view>
          </view>
        </view>
        <view class="filter-group">
          <text class="filter-group-title" aria-role="heading">时代</text>
          <view class="filter-options">
            <view class="filter-option {{filterSheet.eraIndex === index ? 'selected' : ''}}" wx:for="{{eras}}" wx:key="*this"
              data-kind="era" data-index="{{index}}" bindtap="onFilterPick" hover-class="filter-pressed" hover-stay-time="80"
              aria-role="button" aria-label="{{item + (filterSheet.eraIndex === index ? '，已选中' : '')}}">{{item}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="filter-actions">
        <view class="filter-reset" bindtap="resetFilterDraft" hover-class="filter-pressed" hover-stay-time="80" aria-role="button">重置</view>
        <view class="filter-apply" bindtap="applyFilter" hover-class="filter-apply-pressed" hover-stay-time="80" aria-role="button">查看结果</view>
      </view>
    </view>
  </view>
</view>
<feedback-popup></feedback-popup>
<privacy-popup></privacy-popup>
