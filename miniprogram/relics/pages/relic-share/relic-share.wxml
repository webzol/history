<view class="page fs-{{fontClass}}">
  <image class="paper-bg" src="/assets/paper-bg.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="screen">
    <view class="topbar"><text class="top-title" aria-role="heading">共此卷</text></view>
    <view class="relic-empty" aria-live="polite">
      <text>{{failed ? '暂时无法打开这件文物。' : '正在打开文物'}}</text>
      <view wx:if="{{failed}}" class="relic-action" bindtap="goBack" aria-role="button">返回文物列表</view>
    </view>
  </view>
</view>
<feedback-popup></feedback-popup>
<privacy-popup></privacy-popup>
