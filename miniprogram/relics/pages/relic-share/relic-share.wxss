@import "../../common.wxss";

.relic-share-page .ss-qr-wrap { margin: 26rpx 0 32rpx; }
.relic-share-page .ss-canvas { box-shadow: 0 14rpx 34rpx rgba(90, 70, 50, 0.09); }
.relic-share-actions { display: flex; gap: 16rpx; max-width: 306px; margin: 0 auto; }
.share-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  gap: 12rpx;
  min-width: 0;
  min-height: 46px;
  margin: 0;
  padding: 10rpx 12rpx;
  border: 0;
  border-radius: 26rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: calc(27rpx * var(--fs, 1));
  font-weight: 400;
  line-height: 1.4;
}
.share-action::after { border: 0; }
.send-action { background: #F1E8DD; color: #63472F; }
.save-action { background: #EEF0F0; color: #454C4A; }
.send-action.share-action-pressed { background: #EBDFD1; }
.save-action.share-action-pressed { background: #E3E8E7; }
.save-action.share-pending { color: #706C63; }

.share-action-icon { position: relative; flex: 0 0 32rpx; width: 32rpx; height: 32rpx; }
.send-icon::before, .save-icon::before, .save-icon::after { position: absolute; content: ''; }
.send-icon::before {
  left: 4rpx;
  bottom: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border: 1px solid currentColor;
  border-radius: 4rpx;
}
.send-icon::after {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;
  background: linear-gradient(135deg, transparent 45%, currentColor 46%, currentColor 54%, transparent 55%), #F1E8DD;
  content: '';
}
.share-action-pressed .send-icon::after { background-color: #EBDFD1; }
.save-icon::before {
  left: 5rpx;
  bottom: 4rpx;
  right: 5rpx;
  height: 7rpx;
  border: 1px solid currentColor;
  border-top: 0;
  border-radius: 0 0 3rpx 3rpx;
}
.save-icon::after {
  top: 11rpx;
  left: 11rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: rotate(45deg);
}
.save-icon { background: linear-gradient(currentColor, currentColor) center 4rpx / 1px 14rpx no-repeat; }

@media (max-height: 650px) {
  .relic-share-page .ss-canvas { width: 208px; height: 339.2px; }
}
@media (max-height: 520px) {
  .relic-share-page .ss-canvas { width: 176px; height: 287.02px; }
}
